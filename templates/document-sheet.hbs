<section class="modern20-item">
  <header class="modern20-header">
    <img src="{{doc.img}}" alt="" width="64" height="64">
    <div>
      <h1>{{doc.name}}</h1>
      <p class="modern20-meta">{{typeLabel}}{{#if source}} · {{{source}}}{{/if}}</p>
    </div>
    {{#if canEdit}}<a class="m20-edit-toggle {{#if editing}}m20-on{{/if}}" data-action="toggleEdit" data-tooltip="{{#if editing}}Back to the stat block{{else}}Edit every field{{/if}}"><i class="fa-solid {{#if editing}}fa-eye{{else}}fa-pen-to-square{{/if}}"></i> {{#if editing}}View{{else}}Edit{{/if}}</a>{{/if}}
  </header>
  {{#if editing}}
    {{{editFormHtml}}}
  {{else}}
  {{#if status}}
    <div class="m20-status">
      <label>HP <input type="number" name="system.hp.value" value="{{status.hp}}" {{#unless canEdit}}disabled{{/unless}}> / {{status.max}}</label>
      <span class="m20-conditions">
        {{#each status.conditions}}<a class="m20-condition {{#if active}}m20-on{{/if}}" data-action="toggleCondition" data-condition="{{id}}" data-tooltip="{{name}}"><img src="{{img}}" alt="{{name}}" width="20" height="20"></a>{{/each}}
      </span>
    </div>
  {{/if}}
  {{#if canBuild}}
    <div class="m20-rollbar"><a class="m20-roll-button" data-action="buildCharacter" data-tooltip="Make a character from this creature's type, Hit Dice, scores, feats and class levels, to change and advance"><i class="fa-solid fa-hammer"></i> Build as a character</a></div>
  {{/if}}
  {{#if rolls}}
    <div class="m20-rollbar">
      {{#each rolls.saves}}<a class="m20-roll-button" data-action="rollSave" data-save="{{key}}">{{label}} {{bonus}}</a>{{/each}}
      {{#each rolls.abilities}}<a class="m20-roll-button" data-action="rollAbility" data-ability="{{key}}">{{label}} {{score}}</a>{{/each}}
      {{#if rolls.grapple}}<a class="m20-roll-button" data-action="rollGrapple" data-tooltip="Grapple check, opposed">Grapple {{rolls.grapple}}</a>{{/if}}
    </div>
    {{#if rolls.skills.length}}
      <div class="m20-rollbar">{{#each rolls.skills}}<a class="m20-roll-button" data-action="rollSkill" data-index="{{index}}">{{label}} {{bonus}}</a>{{/each}}</div>
    {{/if}}
    {{#each rolls.attacks}}
      <div class="m20-attacks">
        <h3>{{label}}</h3>
        {{#each choices}}
          {{#each this}}
            {{#if first}}<p class="m20-hint m20-or">or</p>{{/if}}
            <div class="m20-attack" data-line="{{line}}" data-choice="{{choice}}" data-index="{{index}}">
              <span class="m20-item-name">{{name}} <span class="m20-hint">{{kind}}</span></span>
              {{#each bonuses}}<a class="m20-roll-button" data-action="rollCreatureAttack" data-bonus="{{bonus}}" data-tooltip="Attack">{{label}}</a>{{/each}}
              {{#if damage}}<a class="m20-roll-button" data-action="rollCreatureDamage" data-tooltip="Damage"><i class="fa-solid fa-burst"></i> {{damage}}</a>{{/if}}
              {{#if note}}<span class="m20-hint">plus {{note}}</span>{{/if}}
            </div>
          {{/each}}
        {{/each}}
      </div>
    {{/each}}
  {{/if}}
  {{{table}}}
  {{#each prose}}
    <div class="modern20-prose">
      {{#if title}}<h2>{{title}}</h2>{{/if}}
      {{{html}}}
    </div>
  {{/each}}
  {{/if}}
  {{#if log}}
    <details class="m20-log">
      <summary><h2>Log ({{log.entries.length}})</h2></summary>
      <div class="m20-log-filters">
        {{#each log.filters}}<a class="m20-roll-button {{#if active}}m20-on{{/if}}" data-action="filterLog" data-filter="{{id}}">{{label}}</a>{{/each}}
      </div>
      {{#each log.entries}}
        <div class="m20-log-entry {{#if build}}m20-log-build{{/if}}">
          <div class="m20-log-head"><span class="m20-tag">{{#if build}}Build{{else}}Session{{/if}}</span> <strong>{{userName}}</strong> <span class="m20-hint">{{when}}</span></div>
          {{#if changes.length}}<ul>{{#each changes}}<li>{{label}}: {{from}} → <strong>{{to}}</strong></li>{{/each}}</ul>{{else}}<p>{{text}}</p>{{/if}}
        </div>
      {{else}}
        <p class="m20-hint">Nothing yet. Changes made from now on are recorded here, with who made them.</p>
      {{/each}}
    </details>
  {{/if}}
</section>
