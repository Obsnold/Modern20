<div class="m20-panel">
  <h3>
    {{localize "MODERN20.Skills.Allocate"}}
    <span class="{{#if overBudget}}m20-over{{/if}}">{{spent}} / {{budget}}</span>
  </h3>
  <p class="m20-hint">{{localize "MODERN20.Skills.Hint"}}</p>

  <table class="m20-skills">
    <thead>
      <tr>
        <th>{{localize "MODERN20.Header.Skill"}}</th>
        <th>{{localize "MODERN20.ClassSkill"}}</th>
        <th>{{localize "MODERN20.Skills.Have"}}</th>
        <th>{{localize "MODERN20.Skills.Add"}}</th>
        <th>{{localize "MODERN20.Total"}}</th>
      </tr>
    </thead>
    <tbody>
      {{#each skillRows as |row|}}
        {{#if row.header}}
          <tr class="m20-skills__subject">
            <td>{{row.label}}{{#if row.trainedOnly}} <span class="m20-hint">*</span>{{/if}}</td>
            <td>{{#if row.classSkill}}<i class="fa-solid fa-check m20-granted"></i>{{/if}}</td>
            <td colspan="3">
              {{!-- Named, and its value comes from state: ApplicationV2 only
                    restores focus for controls it can address by name or id,
                    and a re-render rebuilds the markup from context. --}}
              {{#if row.open}}
                <input type="text" class="m20-subject" name="subject.{{row.key}}"
                       id="m20-subject-{{row.key}}" value="{{row.pick}}"
                       placeholder="{{localize 'MODERN20.Skills.NewSubjectOpen'}}">
              {{else}}
                <select class="m20-subject" name="subject.{{row.key}}" id="m20-subject-{{row.key}}">
                  {{#each row.options as |option|}}
                    <option value="{{option}}" {{#if (eq option ../row.pick)}}selected{{/if}}>{{option}}</option>
                  {{/each}}
                </select>
              {{/if}}
              <button type="button" class="m20-button m20-button--small"
                      data-action="addSubject" data-skill="{{row.key}}">
                {{localize "MODERN20.Skills.AddSubject"}}
              </button>
            </td>
          </tr>
        {{else}}
          <tr class="{{#if row.overCap}}m20-skill--overspent{{/if}} {{#if row.specialty}}m20-skills__variant{{/if}}">
            <td>{{row.label}}{{#unless row.specialty}}{{#if row.trainedOnly}} <span class="m20-hint">*</span>{{/if}}{{/unless}}</td>
            <td>{{#if row.classSkill}}<i class="fa-solid fa-check m20-granted"></i>{{/if}}</td>
            <td>{{row.existing}}</td>
            <td><input type="number" name="{{row.field}}" value="{{row.added}}" min="0"></td>
            <td class="m20-mod">
              {{#if row.perRank}}{{row.total}}{{else}}{{row.total}} / {{row.cap}}{{/if}}
            </td>
          </tr>
        {{/if}}
      {{/each}}
    </tbody>
  </table>
  <p class="m20-hint">{{localize "MODERN20.Skills.TrainedNote"}}</p>
  <p class="m20-hint">{{localize "MODERN20.Skills.LanguageNote"}}</p>
</div>
