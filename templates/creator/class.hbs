<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <p class="m20-hint">{{localize "MODERN20.Creator.ClassHint"}}</p>

  {{#if classes.length}}
    <div class="m20-row">
      <label>{{localize "MODERN20.Creator.Class"}}</label>
      <select name="classId">
        <option value="">{{localize "MODERN20.Creator.None"}}</option>
        {{#each classes as |heroClass|}}
          <option value="{{heroClass.id}}" {{#if (eq heroClass.id ../choices.classId)}}selected{{/if}}>
            {{heroClass.name}}
          </option>
        {{/each}}
      </select>
    </div>

    {{#if chosenClass}}
      <div class="m20-panel">
        <h3>{{chosenClass.name}} {{modern20Rules uuid=chosenClass.rulesPage}}</h3>
        <div class="m20-row">
          <label>{{localize "MODERN20.HitDice"}}</label><span>{{chosenClass.hitDie}}</span>
        </div>
        <div class="m20-row">
          <label>{{localize "MODERN20.SkillPointsSpent"}}</label>
          <span>{{chosenClass.skillPoints}} + {{localize "MODERN20.Ability.Int.long"}}</span>
        </div>
        {{#if classFeatures.length}}
          <p class="m20-hint">
            {{localize "MODERN20.LevelScreen.Grants"}}:
            {{#each classFeatures}}<span class="m20-tag">{{this}}</span> {{/each}}
          </p>
        {{/if}}

        {{#if classTalents.length}}
          <h3>{{localize "MODERN20.LevelScreen.Talent"}}</h3>
          <select name="talentUuid">
            <option value="">{{localize "MODERN20.Creator.None"}}</option>
            {{#each classTalents as |talent|}}
              <option value="{{talent.uuid}}" {{#if (eq talent.uuid ../choices.talentUuid)}}selected{{/if}}>
                {{talent.tree}} &mdash; {{talent.name}}
              </option>
            {{/each}}
          </select>
        {{/if}}
      </div>
    {{/if}}
  {{else}}
    <p class="m20-hint">{{localize "MODERN20.Creator.NoPack"}}</p>
  {{/if}}
</section>
