<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <div class="m20-panel">
    {{!-- The glossary the stat block's senses and qualities are defined in. --}}
    <h3>{{localize "MODERN20.Senses"}} {{modern20Rules topic="specialAbilities"}}</h3>
    <div class="m20-row">
      <input type="text" name="system.senses" value="{{system.senses}}"
             placeholder="{{localize 'MODERN20.Creature.SensesHint'}}">
    </div>
    <div class="m20-row">
      <label>{{localize "MODERN20.SpecialQualities"}}</label>
      <input type="text" name="system.specialQualities" value="{{system.specialQualities}}">
    </div>
  </div>

  <div class="m20-panel">
    <h3>{{localize "MODERN20.Defenses"}}</h3>
    <div class="m20-row">
      <label>{{localize "MODERN20.Actor.Creature.FIELDS.attributes.damageReduction.label"}}</label>
      <input type="number" name="system.attributes.damageReduction.value"
             value="{{system.attributes.damageReduction.value}}">
      {{!-- "15/silver": what gets through it undiminished. --}}
      <input type="text" name="system.attributes.damageReduction.bypass"
             value="{{system.attributes.damageReduction.bypass}}"
             placeholder="{{localize 'MODERN20.Creature.BypassHint'}}">
    </div>

    <div class="m20-row">
      <label>{{localize "MODERN20.Resistances"}}</label>
      {{#each system.attributes.resistances as |resistance index|}}
        <span class="m20-tag">{{resistance.type}} {{resistance.value}}</span>
      {{else}}
        <span class="m20-hint">{{localize "MODERN20.NoneStated"}}</span>
      {{/each}}
    </div>
    <div class="m20-row">
      <label>{{localize "MODERN20.Immunities"}}</label>
      {{#each system.attributes.immunities as |immunity|}}
        <span class="m20-tag">{{immunity}}</span>
      {{else}}
        <span class="m20-hint">{{localize "MODERN20.NoneStated"}}</span>
      {{/each}}
    </div>
    <div class="m20-row">
      <label>{{localize "MODERN20.Vulnerabilities"}}</label>
      {{#each system.attributes.vulnerabilities as |vulnerability|}}
        <span class="m20-tag">{{vulnerability}}</span>
      {{else}}
        <span class="m20-hint">{{localize "MODERN20.NoneStated"}}</span>
      {{/each}}
    </div>
  </div>

  {{#each sections.abilities as |section|}}
    <div class="m20-itemlist">
      <h3>
        {{section.label}}
        <button type="button" class="m20-button m20-button--small"
                data-action="createItem" data-type="{{section.type}}">+</button>
      </h3>
      {{#each section.items as |item|}}
        <div class="m20-itemrow" data-item-id="{{item.id}}">
          <img src="{{item.img}}" alt="{{item.name}}">
          <span class="m20-itemrow__name">{{item.name}}</span>
          {{#if item.abilityTypeLabel}}
            <span class="m20-tag">{{item.abilityTypeLabel}}</span>
          {{/if}}
          {{!-- An ability the SRD gives a save DC posts a card the targets
                roll against, the same one an explosive posts. --}}
          {{#each item.activities as |activity|}}
            <button type="button" class="m20-icon m20-mode" data-player-allowed
                    data-action="useActivity" data-activity="{{activity.id}}"
                    data-tooltip="{{localize activity.label}}">
              {{localize activity.label}}
            </button>
          {{/each}}
          <button type="button" class="m20-icon" data-action="rollItem"
                  title="{{localize 'MODERN20.ToChat'}}">
            <i class="fa-solid fa-comment"></i>
          </button>
          <button type="button" class="m20-icon" data-action="editItem"><i class="fa-solid fa-pen"></i></button>
          <button type="button" class="m20-icon" data-action="deleteItem"><i class="fa-solid fa-trash"></i></button>
        </div>
      {{else}}
        <p class="m20-hint">{{localize "MODERN20.NoneYet"}}</p>
      {{/each}}
    </div>
  {{/each}}
</section>
