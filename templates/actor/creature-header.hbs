<header class="m20-header">
  <img class="m20-portrait" src="{{document.img}}" data-edit="img" alt="{{document.name}}">

  <div class="m20-header__identity">
    <input class="m20-name" type="text" name="name" value="{{document.name}}">
    <div class="m20-header__classes">
      <span class="m20-tag">{{localize (lookup config.sizes system.attributes.size).label}}</span>
      {{#if system.details.creatureType}}<span class="m20-tag">{{system.details.creatureType}}</span>{{/if}}
      {{#if system.details.hitDice}}<span class="m20-tag">{{system.details.hitDice}}</span>{{/if}}
    </div>
  </div>

  <div class="m20-header__stats">
    <div class="m20-stat">
      <label>{{localize "MODERN20.Defense"}}</label>
      <span class="m20-stat__value">{{system.defense.value}}</span>
      <span class="m20-stat__sub">
        {{localize "MODERN20.Touch"}} {{system.defense.touch}} / {{localize "MODERN20.FlatFooted"}} {{system.defense.flatFooted}}
      </span>
    </div>

    <div class="m20-stat">
      <label>{{localize "MODERN20.HitPoints"}}</label>
      <span class="m20-stat__value">
        <input type="number" name="system.hp.value" value="{{system.hp.value}}"> / {{system.hp.max}}
      </span>
      <span class="m20-stat__sub">{{localize "MODERN20.Massive"}} {{system.attributes.massiveDamage}}</span>
    </div>

    <div class="m20-stat">
      <label>{{localize "MODERN20.CR"}}</label>
      <span class="m20-stat__value">
        <input type="text" name="system.details.challengeRating" value="{{system.details.challengeRating}}">
      </span>
      <span class="m20-stat__sub">{{localize "MODERN20.HitDice"}}</span>
    </div>
  </div>
</header>
