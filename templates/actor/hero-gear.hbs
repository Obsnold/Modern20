<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <div class="m20-panel m20-encumbrance">
    <h3>{{localize "MODERN20.Load.Title"}}</h3>
    <div class="m20-row">
      <label>{{localize "MODERN20.Load.Carried"}}</label>
      <span class="m20-mod">{{system.attributes.encumbrance.carried}} lb.</span>
      <span class="m20-tag {{#if (eq system.attributes.encumbrance.level 'over')}}m20-over{{/if}}">
        {{localize system.attributes.encumbrance.label}}
      </span>
      <span class="m20-hint">
        {{system.attributes.encumbrance.limits.light}} /
        {{system.attributes.encumbrance.limits.medium}} /
        {{system.attributes.encumbrance.limits.heavy}} lb.
      </span>
    </div>
    {{#unless (eq system.attributes.encumbrance.speed system.attributes.speed)}}
      <p class="m20-hint m20-over">
        {{localize "MODERN20.Load.SpeedReduced"}}
        {{system.attributes.speed}} &rarr; {{system.attributes.encumbrance.speed}} ft.
      </p>
    {{/unless}}
  </div>

  {{#if containers.length}}
    <div class="m20-itemlist">
      <h3>{{localize "MODERN20.ItemType.container"}}</h3>
      {{#each containers as |entry|}}
        <div class="m20-itemrow" data-item-id="{{entry.item.id}}">
          <img src="{{entry.item.img}}" alt="{{entry.item.name}}">
          <span class="m20-itemrow__name">{{entry.item.name}}</span>
          <span class="m20-tag {{#if entry.over}}m20-over{{/if}}">
            {{entry.carried}}{{#if entry.capacity}} / {{entry.capacity}}{{/if}} lb
          </span>
          <span class="m20-hint">{{entry.contents.length}} {{localize "MODERN20.Container.Items"}}</span>
          <button type="button" class="m20-icon" data-action="editItem"><i class="fa-solid fa-pen"></i></button>
          <button type="button" class="m20-icon" data-action="deleteItem"><i class="fa-solid fa-trash"></i></button>
        </div>
        {{#each entry.contents as |item|}}
          <div class="m20-itemrow m20-itemrow--packed" data-item-id="{{item.id}}">
            <span class="m20-itemrow__name">{{item.name}}</span>
            <span class="m20-hint">{{item.system.weight}} lb</span>
            <button type="button" class="m20-icon" data-action="unpackItem"
                    data-tooltip="{{localize 'MODERN20.Container.Unpack'}}">
              <i class="fa-solid fa-box-open"></i>
            </button>
          </div>
        {{/each}}
      {{/each}}
    </div>
  {{/if}}

  {{#each sections.gear as |section|}}
    <div class="m20-itemlist">
      <h3>
        {{section.label}}
        <button type="button" class="m20-button m20-button--small"
                data-action="createItem" data-type="{{section.type}}">+</button>
      </h3>
      {{#each section.items as |item|}}
        <div class="m20-itemrow" data-item-id="{{item.id}}">
          <img src="{{item.img}}" alt="{{item.name}}">
          <span class="m20-itemrow__name">{{item.name}}</span>
          {{#if item.system.damage}}<span class="m20-tag">{{item.system.damage}}</span>{{/if}}
          {{#if item.system.equipmentBonus}}<span class="m20-tag">+{{item.system.equipmentBonus}} {{localize "MODERN20.Def"}}</span>{{/if}}
          <span class="m20-tag m20-tag--dc">{{localize "MODERN20.PurchaseDCShort"}} {{item.system.purchaseDC}}</span>
          {{#unless (eq item.type "gear")}}
            <button type="button" class="m20-icon {{#if item.system.equipped}}m20-icon--on{{/if}}"
                    data-action="toggleEquipped"
                    data-tooltip="{{#if item.system.equipped}}{{localize 'MODERN20.Equip.Stow'}}{{else}}{{localize 'MODERN20.Equip.Wear'}}{{/if}}">
              <i class="fa-solid {{#if item.system.equipped}}fa-shield-halved{{else}}fa-shield{{/if}}"></i>
            </button>
          {{/unless}}
          <button type="button" class="m20-icon" data-action="purchaseItem" title="{{localize 'MODERN20.BuyHint'}}">
            <i class="fa-solid fa-cart-shopping"></i>
          </button>
          {{#if item.activities.length}}
            {{#each item.activities as |activity|}}
              <button type="button" class="m20-icon m20-mode"
                      data-action="useActivity" data-activity="{{activity.id}}"
                      {{#unless activity.available}}disabled{{/unless}}
                      data-tooltip="{{localize activity.label}}{{#if activity.reason}} — {{localize activity.reason}}{{/if}}{{#if activity.unskilled}} — {{localize 'MODERN20.Attack.AutofireUnskilled'}}{{/if}}">
                {{localize activity.label}}
              </button>
            {{/each}}
          {{else}}
            <button type="button" class="m20-icon" data-action="rollItem"><i class="fa-solid fa-dice-d20"></i></button>
          {{/if}}
          <button type="button" class="m20-icon" data-action="editItem"><i class="fa-solid fa-pen"></i></button>
          <button type="button" class="m20-icon" data-action="deleteItem"><i class="fa-solid fa-trash"></i></button>
        </div>
      {{else}}
        <p class="m20-hint">{{localize "MODERN20.NoneYet"}}</p>
      {{/each}}
    </div>
  {{/each}}
</section>
