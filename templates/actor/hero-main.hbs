<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <div class="m20-columns">
    <div class="m20-panel">
      <h3>{{localize "MODERN20.Abilities"}} {{modern20Rules topic="abilities"}}</h3>
      {{#each system.abilities as |ability key|}}
        <div class="m20-row">
          <button type="button" class="m20-roll" data-action="rollAbility" data-ability="{{key}}">
            {{localize (lookup ../config.abilities key)}}
          </button>
          <input type="number" name="system.abilities.{{key}}.value" value="{{ability.value}}">
          <span class="m20-mod">{{modern20Signed ability.mod}}</span>
        </div>
      {{/each}}
    </div>

    <div class="m20-panel">
      <h3>{{localize "MODERN20.SavingThrows"}} {{modern20Rules topic="saves"}}</h3>
      {{#each system.saves as |save key|}}
        <div class="m20-row">
          <button type="button" class="m20-roll" data-action="rollSave" data-save="{{key}}">
            {{localize (lookup (lookup ../config.saves key) "label")}}
          </button>
          <input type="number" name="system.saves.{{key}}.base" value="{{save.base}}">
          <span class="m20-mod">{{modern20Signed save.value}}</span>
        </div>
      {{/each}}

      <h3>{{localize "MODERN20.Combat"}} {{modern20Rules topic="combat"}}</h3>
      <div class="m20-row">
        <label>{{localize "MODERN20.BaseAttack"}}</label>
        <span class="m20-mod">{{modern20Signed system.attributes.baseAttack}}</span>
        {{#if combat.multiattack}}
          <span class="m20-tag" data-tooltip="{{localize 'MODERN20.Attack.FullAttackHint'}}">
            {{combat.sequence}}
          </span>
        {{/if}}
      </div>
      <div class="m20-row">
        <label>{{localize "MODERN20.Initiative"}}</label>
        <span class="m20-mod">{{modern20Signed system.attributes.initiative.value}}</span>
      </div>
      <div class="m20-row">
        <label>{{localize "MODERN20.Grapple"}}</label>
        <span class="m20-mod">{{modern20Signed system.attributes.grapple}}</span>
      </div>
      <div class="m20-row">
        <label>{{localize "MODERN20.Speed"}}</label>
        <input type="number" name="system.attributes.speed" value="{{system.attributes.speed}}">
      </div>
      <div class="m20-row">
        <label>{{localize "MODERN20.Label.Size"}}</label>
        <select name="system.attributes.size">
          {{#each config.sizes as |size key|}}
            <option value="{{key}}" {{#if (eq key ../system.attributes.size)}}selected{{/if}}>
              {{localize size.label}}
            </option>
          {{/each}}
        </select>
      </div>
    </div>

    <div class="m20-panel m20-turn" data-player-allowed>
      <h3>
        {{localize "MODERN20.Action.Title"}}
        {{modern20Rules topic="actions"}}
        <button type="button" class="m20-button m20-button--small" data-action="endTurn">
          {{localize "MODERN20.Action.Reset"}}
        </button>
      </h3>

      <div class="m20-row">
        {{#each combat.pools as |pool|}}
          <span class="m20-tag {{#unless pool.remaining}}m20-over{{/unless}}"
                data-tooltip="{{pool.label}}">
            {{pool.label}}: {{pool.remaining}}
          </span>
        {{/each}}
        <button type="button" class="m20-icon" data-action="fiveFootStep"
                data-tooltip="{{localize 'MODERN20.Action.FiveFootStep'}}">
          <i class="fa-solid fa-shoe-prints"></i>
        </button>
      </div>

      <h3>{{localize "MODERN20.Stance.Title"}}</h3>
      <div class="m20-row m20-stances">
        {{#each combat.stances as |stance|}}
          <button type="button"
                  class="m20-button m20-button--small {{#if stance.active}}m20-icon--on{{/if}}"
                  data-action="takeStance" data-stance="{{stance.id}}"
                  data-tooltip="{{localize 'MODERN20.Action.Costs' action=stance.action}}">
            {{localize stance.label}}
          </button>
        {{/each}}
      </div>
      {{#unless combat.stance}}
        <p class="m20-hint">{{localize "MODERN20.Stance.None"}}</p>
      {{/unless}}
    </div>
  </div>
</section>
