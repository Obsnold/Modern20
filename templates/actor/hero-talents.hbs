<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  {{#unless system.details.classLevels.length}}
    <div class="m20-panel m20-panel--callout">
      <h3>{{localize "MODERN20.Creator.Title"}}</h3>
      <p class="m20-hint">{{localize "MODERN20.Creator.Callout"}}</p>
      <button type="button" class="m20-button" data-action="openCreator">
        {{localize "MODERN20.Creator.Open"}}
      </button>
    </div>
  {{/unless}}

  {{#each sections.character as |section|}}
    <div class="m20-itemlist">
      <h3>
        {{section.label}}
        <button type="button" class="m20-button m20-button--small"
                data-action="createItem" data-type="{{section.type}}">+</button>
      </h3>
      {{#each section.items as |item|}}
        <div class="m20-itemrow" data-item-id="{{item.id}}">
          <img src="{{item.img}}" alt="{{item.name}}">
          <span class="m20-itemrow__name">{{item.name}}</span>
          {{#if item.system.tree}}<span class="m20-tag">{{item.system.tree}}</span>{{/if}}
          {{#if item.grantSource}}
            <span class="m20-tag m20-tag--source" data-tooltip="{{item.grantSource}}">
              <i class="fa-solid fa-link"></i> {{item.grantSource}}
            </span>
          {{/if}}
          {{#if (eq item.type "class")}}
            <span class="m20-levelctl">
              <button type="button" class="m20-icon" data-action="adjustClassLevel" data-delta="-1"
                      title="{{localize 'MODERN20.LevelDown'}}"><i class="fa-solid fa-minus"></i></button>
              <span class="m20-tag">{{localize "MODERN20.Level"}} {{item.system.levels}}</span>
              <button type="button" class="m20-icon" data-action="adjustClassLevel" data-delta="1"
                      title="{{localize 'MODERN20.LevelUp'}}"><i class="fa-solid fa-plus"></i></button>
            </span>
          {{/if}}
          <button type="button" class="m20-icon" data-action="rollItem" title="{{localize 'MODERN20.ToChat'}}">
            <i class="fa-solid fa-comment"></i>
          </button>
          <button type="button" class="m20-icon" data-action="editItem"><i class="fa-solid fa-pen"></i></button>
          <button type="button" class="m20-icon" data-action="deleteItem"><i class="fa-solid fa-trash"></i></button>
        </div>
      {{else}}
        <p class="m20-hint">{{localize "MODERN20.NoneYet"}}</p>
      {{/each}}
    </div>
  {{/each}}

  {{#if advancement.length}}
    <div class="m20-itemlist">
      <h3>{{localize "MODERN20.Source.LogTitle"}}</h3>
      {{#each advancement as |entry|}}
        <div class="m20-logentry">
          <span class="m20-tag m20-tag--level">
            {{localize "MODERN20.CharacterLevel"}} {{entry.characterLevel}}
          </span>
          <span class="m20-logentry__body">
            <strong>{{entry.className}} {{entry.classLevel}}</strong>
            &middot; +{{entry.hitPoints}} {{localize "MODERN20.HitPoints"}}
            {{#if entry.gained.length}}
              <br><span class="m20-hint">{{#each entry.gained}}{{this}}{{#unless @last}} &middot; {{/unless}}{{/each}}</span>
            {{/if}}
            {{#if entry.note}}<br><span class="m20-hint">{{entry.note}}</span>{{/if}}
          </span>
        </div>
      {{/each}}
    </div>
  {{/if}}
</section>
