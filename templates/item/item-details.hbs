<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">

  {{#if (eq document.type "class")}}
    {{formField fields.tier value=system.tier}}
    {{formField fields.levels value=system.levels}}
    {{formField fields.hitDie value=system.hitDie}}
    {{formField fields.keyAbility value=system.keyAbility}}
    {{formField fields.skillPointsPerLevel value=system.skillPointsPerLevel}}
    <p class="m20-hint">{{localize "MODERN20.Hint.ClassProgression"}}</p>
  {{/if}}

  {{#if (eq document.type "occupation")}}
    {{formField fields.wealthBonus value=system.wealthBonus}}
    {{formField fields.reputationBonus value=system.reputationBonus}}
    {{formField fields.skillChoiceCount value=system.skillChoiceCount}}
    {{#if system.bonusFeatOptions.length}}
      <div class="form-group">
        <label>{{localize "MODERN20.Occupation.FeatTitle2"}}</label>
        <div class="form-fields">
          <select name="system.bonusFeatChosen">
            <option value="">{{localize "MODERN20.Creator.None"}}</option>
            {{#each system.bonusFeatOptions as |feat|}}
              <option value="{{feat}}" {{#if (eq feat ../system.bonusFeatChosen)}}selected{{/if}}>{{feat}}</option>
            {{/each}}
          </select>
        </div>
      </div>
    {{/if}}

    <fieldset>
      <legend>{{localize "MODERN20.Occupation.Chosen"}}</legend>
      <div class="m20-choices">
        {{#each system.skillOptions as |option|}}
          <label class="m20-choice">
            <input type="checkbox" name="system.skillsChosen" value="{{option.skill}}"
                   {{#if (includes ../system.skillsChosen option.skill)}}checked{{/if}}>
            <span>{{option.label}}</span>
          </label>
        {{else}}
          <p class="m20-hint">{{localize "MODERN20.Occupation.NoOptions"}}</p>
        {{/each}}
      </div>
    </fieldset>
  {{/if}}

  {{#if (eq document.type "talent")}}
    {{formField fields.tree value=system.tree}}
    {{formField fields.sourceClass value=system.sourceClass}}
  {{/if}}

  {{#if (eq document.type "feat")}}
    {{formField fields.featType value=system.featType}}
    {{formField fields.repeatable value=system.repeatable}}
    {{formField fields.benefit value=system.benefit toggled=true}}
    {{formField fields.normal value=system.normal toggled=true}}
    {{formField fields.special value=system.special toggled=true}}
  {{/if}}

  {{#if (eq document.type "specialAbility")}}
    {{!-- Most abilities a creature's type confers print no category, so the
          blank option is a real answer rather than an unset field. --}}
    <div class="form-group">
      <label>{{localize "MODERN20.Item.SpecialAbility.FIELDS.abilityType.label"}}</label>
      <div class="form-fields">
        <select name="system.abilityType">
          <option value="">{{localize "MODERN20.Creator.None"}}</option>
          {{#each config.specialAbilityTypes as |label key|}}
            <option value="{{key}}" {{#if (eq key ../system.abilityType)}}selected{{/if}}>
              {{localize label}}
            </option>
          {{/each}}
        </select>
      </div>
    </div>
    {{formField fields.sense value=system.sense}}
  {{/if}}

  {{#if (eq document.type "weapon")}}
    {{formField fields.category value=system.category}}
    {{formField fields.damage value=system.damage}}
    {{formField fields.damageType value=system.damageType}}
    {{formField fields.critical value=system.critical}}
    {{formField fields.ranged value=system.ranged}}
    {{formField fields.reach value=system.reach}}
    {{formField fields.reachOnly value=system.reachOnly}}
    {{formField fields.rangeIncrement value=system.rangeIncrement}}
    {{#if maxRange}}
      <p class="m20-hint">
        {{localize "MODERN20.Attack.MaxRange"}}: {{maxRange}} ft.
        ({{maxIncrements}} &times; {{system.rangeIncrement}} ft.)
      </p>
    {{/if}}
    {{formField fields.rateOfFire value=system.rateOfFire}}
    {{formField fields.magazine value=system.magazine}}
    {{formField fields.caliber value=system.caliber}}
    {{formField fields.ammo value=system.ammo}}
    {{formField fields.attackBonus value=system.attackBonus}}
    {{formField fields.damageBonus value=system.damageBonus}}
  {{/if}}

  {{#if (eq document.type "armor")}}
    {{formField fields.armorType value=system.armorType}}
    {{formField fields.equipmentBonus value=system.equipmentBonus}}
    {{formField fields.maxDex value=system.maxDex}}
    {{formField fields.armorPenalty value=system.armorPenalty}}
    {{formField fields.speedPenalty value=system.speedPenalty}}
    {{formField fields.proficiency value=system.proficiency}}
  {{/if}}

  {{#if (eq document.type "vehicleMod")}}
    {{formField fields.slot value=system.slot}}
    {{formField fields.effect value=system.effect}}
  {{/if}}

  {{#if (eq document.type "gear")}}
    {{formField fields.category value=system.category}}
    {{formField fields.caliber value=system.caliber}}
    {{#if system.caliber}}
      <div class="form-group">
        <label>{{localize "MODERN20.Ammunition.Special"}}</label>
        <div class="form-fields">
          <select name="system.special">
            <option value="">{{localize "MODERN20.Ammunition.Ordinary"}}</option>
            {{#each config.specialAmmunition as |type key|}}
              <option value="{{key}}" {{#if (eq key ../system.special)}}selected{{/if}}>
                {{type.name}} ({{localize "MODERN20.PurchaseDCShort"}} {{type.purchaseDCModifier}})
              </option>
            {{/each}}
          </select>
        </div>
      </div>
    {{/if}}
    {{#if weapons.length}}
      <div class="form-group">
        <label>{{localize "MODERN20.Accessory.FittedTo"}}</label>
        <div class="form-fields">
          <select name="system.attachedTo">
            <option value="">{{localize "MODERN20.Creator.None"}}</option>
            {{#each weapons as |weapon|}}
              <option value="{{weapon.id}}" {{#if (eq weapon.id ../system.attachedTo)}}selected{{/if}}>
                {{weapon.name}}
              </option>
            {{/each}}
          </select>
        </div>
      </div>
    {{/if}}
  {{/if}}

  {{#if (eq document.type "container")}}
    {{formField fields.category value=system.category}}
    {{formField fields.capacity value=system.capacity}}
    <p class="m20-hint">{{localize "MODERN20.Container.CapacityHint"}}</p>
  {{/if}}

  {{#if (eq document.type "spell")}}
    {{formField fields.level value=system.level}}
    {{formField fields.school value=system.school}}
    {{formField fields.subschool value=system.subschool}}
    {{formField fields.components value=system.components}}
    {{formField fields.castingTime value=system.castingTime}}
    {{formField fields.range value=system.range}}
    {{formField fields.area value=system.area}}
    {{formField fields.target value=system.target}}
    {{formField fields.duration value=system.duration}}
    {{formField fields.savingThrow value=system.savingThrow}}
    {{formField fields.spellResistance value=system.spellResistance}}
    {{formField fields.prepared value=system.prepared}}
    <fieldset>
      <legend>{{localize "MODERN20.Cast.Casting"}}</legend>
      {{formField fields.tradition value=system.tradition}}
      {{formField fields.lists.fields.arcane value=system.lists.arcane}}
      {{formField fields.lists.fields.divine value=system.lists.divine}}
      {{formField fields.damage value=system.damage}}
      {{formField fields.damageType value=system.damageType}}
      {{formField fields.scaling.fields.per value=system.scaling.per}}
      {{formField fields.scaling.fields.max value=system.scaling.max}}
      {{formField fields.saveAbility value=system.saveAbility}}
      {{formField fields.saveEffect value=system.saveEffect}}
      {{formField fields.areaShape.fields.size value=system.areaShape.size}}
    </fieldset>
  {{/if}}

  {{#if (eq document.type "psiPower")}}
    {{formField fields.level value=system.level}}
    {{formField fields.powerPoints value=system.powerPoints}}
    {{formField fields.display value=system.display}}
    {{formField fields.castingTime value=system.castingTime}}
    {{formField fields.range value=system.range}}
    {{formField fields.duration value=system.duration}}
    {{formField fields.savingThrow value=system.savingThrow}}
    <fieldset>
      <legend>{{localize "MODERN20.Cast.Casting"}}</legend>
      {{formField fields.keyAbility value=system.keyAbility}}
      {{formField fields.damage value=system.damage}}
      {{formField fields.damageType value=system.damageType}}
      {{formField fields.scaling.fields.per value=system.scaling.per}}
      {{formField fields.scaling.fields.max value=system.scaling.max}}
      {{formField fields.saveAbility value=system.saveAbility}}
      {{formField fields.saveEffect value=system.saveEffect}}
      {{formField fields.areaShape.fields.size value=system.areaShape.size}}
    </fieldset>
  {{/if}}

  {{#if isPurchasable}}
    <fieldset>
      <legend>{{localize "MODERN20.Acquisition"}}</legend>
      {{formField fields.purchaseDC value=system.purchaseDC}}
      {{formField fields.restriction value=system.restriction}}
      {{formField fields.weight value=system.weight}}
      {{formField fields.quantity value=system.quantity}}
      {{formField fields.equipped value=system.equipped}}
    </fieldset>
  {{/if}}

  {{#if hasPrerequisites}}
    <fieldset class="m20-prereqs">
      <legend>
        {{localize "MODERN20.Prerequisites"}}
        <button type="button" class="m20-button m20-button--small" data-action="addPrerequisite">+</button>
      </legend>
      <p class="m20-hint">{{localize "MODERN20.Hint.PrerequisitesAdvisory"}}</p>
      {{#each system.prerequisites as |prereq index|}}
        <div class="m20-row">
          <input type="text" name="system.prerequisites.{{index}}" value="{{prereq}}">
          <button type="button" class="m20-icon" data-action="removePrerequisite" data-index="{{index}}">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      {{/each}}
    </fieldset>
  {{/if}}
</section>
