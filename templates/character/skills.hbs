<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  {{#if advancement.skillPoints}}<p class="{{#if advancement.skillPoints.over}}m20-warning{{else}}m20-hint{{/if}}" data-tooltip="{{advancement.skillPoints.parts}}">Skill points spent: {{advancement.skillPoints.text}}. Maximum ranks: your level + 3 in a class skill, half that cross-class.</p>{{/if}}
  {{#if levelling.classes.length}}
    <p class="m20-levelling">Buying ranks as
      <select name="system.levellingAs" data-tooltip="Each level's skill points are spent as the class that level is in: a rank costs 1 point in that class's skills, 2 in any other">
        {{#each levelling.classes}}<option value="{{name}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
      </select>
      <span class="m20-hint">Points are worked out as you change ranks; correct any by hand.</span>
    </p>
  {{/if}}
  <table class="m20-table m20-skills">
    <thead><tr><th>Skill</th><th>Class</th><th>Ranks</th><th data-tooltip="Skill points these ranks cost">Pts</th><th>Misc</th><th>Total</th></tr></thead>
    <tbody>
      {{#each skills}}
        {{#if header}}
          <tr class="m20-skill-group" data-skill="{{key}}">
            <th>{{name}}</th>
            <td colspan="5">
              <input type="text" class="m20-new-specialty" list="m20-specialties-{{key}}" placeholder="Add a specialty">
              <a data-action="addSpecialty" data-tooltip="Add"><i class="fa-solid fa-plus"></i></a>
            </td>
          </tr>
        {{else}}
          <tr class="{{#unless usable}}m20-unusable{{/unless}} {{#if overMax}}m20-over{{/if}} {{#if restricted}}m20-restricted{{/if}}" {{#if restricted}}data-tooltip="Only characters with a class or feat (Arcane Skills, Psionic Skills) that grants this skill can buy ranks in it"{{/if}}>
            <td class="{{#if specialty}}m20-indent{{/if}}"><a data-action="rollSkill" data-skill="{{key}}" data-specialty="{{specialty}}" data-tooltip="Roll a {{label}} check">{{label}}</a>{{#if trainedOnly}}<sup data-tooltip="Trained only">T</sup>{{/if}}{{#if armorPenalty}}<sup data-tooltip="Armor penalty applies">A</sup>{{/if}}</td>
            <td>
              {{#if fromItems}}<i class="fa-solid fa-check" data-tooltip="{{sourceLabel}}{{#if occupationBonus}}; chosen from your occupation as well, for +1{{/if}}"></i>
              {{else if path}}<input type="checkbox" name="{{path}}.classSkill" {{#if classSkill}}checked{{/if}} data-tooltip="Make this a class skill (a Personality's Bonus Class Skill, a GM's ruling)">
              {{else}}<input type="checkbox" name="system.specialtySkills.{{index}}.classSkill" {{#if classSkill}}checked{{/if}} data-tooltip="Make this a class skill (a Personality's Bonus Class Skill, a GM's ruling)">{{/if}}
            </td>
            {{#if path}}
              <td><input type="number" step="0.5" min="0" name="{{path}}.ranks" value="{{ranks}}" data-tooltip="Max {{maxRanks}}"></td>
              <td><input type="number" min="0" name="{{path}}.points" value="{{points}}" placeholder="{{pointsEstimate}}" data-tooltip="A rank costs {{cost}} now; empty: ranks at today's cost"></td>
              <td><input type="number" name="{{path}}.misc" value="{{misc}}"></td>
            {{else}}
              <td><input type="number" step="0.5" min="0" name="system.specialtySkills.{{index}}.ranks" value="{{ranks}}" data-tooltip="Max {{maxRanks}}"></td>
              <td><input type="number" min="0" name="system.specialtySkills.{{index}}.points" value="{{points}}" placeholder="{{pointsEstimate}}" data-tooltip="A rank costs {{cost}} now; empty: ranks at today's cost"></td>
              <td><input type="number" name="system.specialtySkills.{{index}}.misc" value="{{misc}}"></td>
            {{/if}}
            <td class="m20-strong">{{total}}{{#if specialty}} <a data-action="removeSpecialty" data-index="{{index}}" data-tooltip="Remove"><i class="fa-solid fa-xmark"></i></a>{{/if}}</td>
          </tr>
        {{/if}}
      {{/each}}
    </tbody>
  </table>
  {{#each specialtyChoices}}
    <datalist id="m20-specialties-{{key}}">{{#each specialties}}<option value="{{this}}"></option>{{/each}}</datalist>
  {{/each}}
</section>
