<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <div class="m20-columns">
    <div class="m20-panel">
      <h3>Abilities</h3>
      <table class="m20-table">
        <thead><tr><th></th><th>Base</th><th data-tooltip="From species and templates">Adj.</th><th>Score</th><th>Mod</th></tr></thead>
        <tbody>
          {{#each abilities}}
            <tr>
              <th><a data-action="rollAbility" data-ability="{{key}}" data-tooltip="Roll a {{label}} check">{{label}}</a></th>
              <td><input type="number" name="system.abilities.{{key}}.value" value="{{value}}" placeholder="—"></td>
              <td>{{adjustment}}</td>
              <td>{{score}}</td>
              <td class="m20-strong">{{modifier}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      {{#if advancement.increases.length}}
        <div class="m20-increases">
          <span class="m20-hint">+1 every 4 levels:</span>
          {{#each advancement.increases}}
            <label class="{{#if extra}}m20-warning{{/if}}" {{#if extra}}data-tooltip="More than your level gives"{{/if}}>{{level}}th
              <select data-increase="{{index}}"><option value="">—</option>{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>
            </label>
          {{/each}}
        </div>
      {{/if}}
    </div>

    <div class="m20-panel">
      <h3>Combat</h3>
      <dl class="m20-stats">
        <dt>Defense</dt><dd class="m20-strong" data-tooltip="{{combat.tips.defense}}">{{combat.defense.value}}{{#if combat.defenseNotes}} <i class="fa-solid fa-circle-info m20-hint" data-tooltip="{{combat.defenseNotes}}"></i>{{/if}}</dd>
        {{#if combat.resistances}}<dt>Damage reduction</dt><dd data-tooltip="Applied by Apply on damage cards">{{combat.resistances}}</dd>{{/if}}
        <dt>Touch / Flat-footed</dt><dd>{{combat.defense.touch}} / {{combat.defense.flatFooted}}</dd>
        <dt>Base Attack Bonus</dt><dd>{{combat.bab}}</dd>
        <dt>Initiative</dt><dd data-tooltip="{{combat.tips.initiative}}">{{combat.initiative}}</dd>
        <dt><a data-action="rollGrapple" data-tooltip="Grapple check: base attack + Str + size, opposed">Grapple</a></dt><dd data-tooltip="{{combat.tips.grapple}}">{{combat.grapple}}</dd>
        <dt>Speed</dt><dd data-tooltip="Base {{combat.speed.base}} ft.{{#if combat.speed.armored}}, slowed by armor{{/if}}; double move {{combat.speed.double}} ft., run {{combat.speed.run}} ft.">{{combat.speed.value}} ft.</dd>
        <dt>Base speed</dt><dd><input type="number" name="system.baseSpeed" value="{{system.baseSpeed}}" placeholder="{{combat.speed.default}}" step="5" data-tooltip="Empty: your species' speed, or 30 ft."></dd>
        <dt>Unarmed</dt><dd class="m20-unarmed">
          <a class="m20-roll-button" data-action="rollUnarmed" data-tooltip="Unarmed strike: {{combat.unarmed}}"><i class="fa-solid fa-hand-fist"></i></a>
          <a class="m20-roll-button" data-action="rollGrab" data-tooltip="Grab: a melee touch attack to start a grapple"><i class="fa-solid fa-hand"></i></a>
        </dd>
        <dt>Reputation</dt><dd data-tooltip="{{combat.tips.reputation}}">{{combat.reputation}}</dd>
        <dt>Massive Damage</dt><dd>{{combat.massiveDamage}}</dd>
        <dt>Size</dt><dd><select name="system.size" data-tooltip="Empty: the species' size, or Medium"><option value="">—</option>{{#each sizes}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></dd>
        <dt>Natural armor</dt><dd><input type="number" name="system.naturalArmor" value="{{system.naturalArmor}}" data-tooltip="Added to any the species gives"></dd>
        <dt>Defense (misc)</dt><dd><input type="number" name="system.defense.misc" value="{{system.defense.misc}}"></dd>
        <dt><a data-action="wealthCheck" data-tooltip="Buy something: a Wealth check against its purchase DC">Wealth</a></dt><dd class="m20-wealth"><input type="number" name="system.wealth.value" value="{{system.wealth.value}}" data-tooltip="{{wealthCondition}}">
          <a data-action="startingWealth" data-tooltip="Roll starting Wealth: 2d4 + occupation + Windfall + 1 for Profession ranks"><i class="fa-solid fa-dice"></i></a>
          {{#if wealthDue}}<a class="m20-roll-button" data-action="regainWealth" data-tooltip="A Profession check (Wisdom without ranks) against your Wealth bonus: +1, and +1 per 5 over">Wealth for level {{wealthDue}}</a>
            <a data-action="wealthDone" data-tooltip="Already done for every level you have: a character made before this was tracked"><i class="fa-solid fa-check"></i></a>{{/if}}
        </dd>
      </dl>
      <h3>Saves</h3>
      <dl class="m20-stats">
        {{#each saves}}<dt><a data-action="rollSave" data-save="{{key}}" data-tooltip="Roll a {{label}} save">{{label}}</a></dt><dd class="m20-strong" data-tooltip="{{tip}}">{{total}}</dd>{{/each}}
      </dl>
    </div>
  </div>

  <div class="m20-panel">
    <h3>Classes{{#if creatureType}} <span class="m20-hint">({{creatureType}})</span>{{/if}}</h3>
    <p class="m20-levelling"><label data-tooltip="A nonheroic character: the basic classes only, no action points, no talents or bonus feats, and 1st-level hit points rolled rather than the maximum"><input type="checkbox" name="system.ordinary" {{#if system.ordinary}}checked{{/if}}> Ordinary</label></p>
    {{#if startingClass}}
      <p class="m20-levelling">First level as
        <select name="system.startingClass" data-tooltip="The class of your 1st level: its maximum hit points, ×4 skill points and starting feats">
          {{#each startingClass}}<option value="{{name}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}
        </select>
      </p>
    {{/if}}
    {{#each creatureTypes}}
      <div class="m20-class" data-item-id="{{id}}">
        <img src="{{img}}" alt="" width="32" height="32">
        <a class="m20-item-name" data-action="editItem">{{name}}</a>
        <label>Hit Dice <input type="number" min="0.125" step="any" value="{{count}}" data-item-field="count"></label>
        {{#if replaced}}
          <span class="m20-hint" data-tooltip="A creature of 1 Hit Die or less that takes class levels loses its own Hit Die">Replaced by class levels</span>
        {{else}}
          <span class="m20-rolls">HP (d{{hitDie}}):
            {{#each rolls}}<input type="number" min="1" value="{{value}}" placeholder="—" data-item-field="hitPoints" data-index="{{index}}">{{/each}}
          </span>
        {{/if}}
        <a data-action="deleteItem" data-tooltip="Remove"><i class="fa-solid fa-trash"></i></a>
      </div>
    {{/each}}
    {{#each classes}}
      <div class="m20-class" data-item-id="{{id}}">
        <img src="{{img}}" alt="" width="32" height="32">
        <a class="m20-item-name" data-action="editItem">{{name}}</a>
        <label>Level <input type="number" min="1" max="{{max}}" value="{{level}}" data-item-field="level"></label>
        <span class="m20-rolls">HP (d{{hitDie}}):
          {{#each rolls}}<input type="number" min="1" value="{{value}}" placeholder="—" data-item-field="hitPoints" data-index="{{index}}">{{/each}}
        </span>
        <a data-action="deleteItem" data-tooltip="Remove"><i class="fa-solid fa-trash"></i></a>
      </div>
      {{#if requirements}}
        <p class="m20-requirements {{#if requirements.met}}m20-hint{{else}}m20-warning{{/if}}">
          {{#if requirements.met}}<i class="fa-solid fa-check"></i> Requirements met{{else}}<i class="fa-solid fa-triangle-exclamation"></i> Requirements not met: {{requirements.unmet}}{{/if}}{{#if requirements.check}} <span class="m20-hint">(check by hand: {{requirements.check}})</span>{{/if}}
        </p>
      {{/if}}
    {{else}}
      {{#unless creatureTypes.length}}<p class="m20-hint">Drag a class from the Classes compendium onto this sheet, or a creature type to build a creature.</p>{{/unless}}
    {{/each}}
  </div>
</section>
