<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  <div class="m20-columns">
    <div class="m20-panel">
      <h3>Abilities</h3>
      <table class="m20-table">
        <thead><tr><th></th><th>Base</th><th>Species</th><th>Score</th><th>Mod</th></tr></thead>
        <tbody>
          {{#each abilities}}
            <tr>
              <th>{{label}}</th>
              <td><input type="number" name="system.abilities.{{key}}.value" value="{{value}}" placeholder="—"></td>
              <td>{{adjustment}}</td>
              <td>{{score}}</td>
              <td class="m20-strong">{{modifier}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <div class="m20-panel">
      <h3>Combat</h3>
      <dl class="m20-stats">
        <dt>Defense</dt><dd class="m20-strong">{{combat.defense.value}}</dd>
        <dt>Touch / Flat-footed</dt><dd>{{combat.defense.touch}} / {{combat.defense.flatFooted}}</dd>
        <dt>Base Attack Bonus</dt><dd>{{combat.bab}}</dd>
        <dt>Initiative</dt><dd>{{combat.initiative}}</dd>
        <dt>Grapple</dt><dd>{{combat.grapple}}</dd>
        <dt>Reputation</dt><dd>{{combat.reputation}}</dd>
        <dt>Massive Damage</dt><dd>{{combat.massiveDamage}}</dd>
        <dt>Defense (misc)</dt><dd><input type="number" name="system.defense.misc" value="{{system.defense.misc}}"></dd>
        <dt>Wealth</dt><dd><input type="number" name="system.wealth.value" value="{{system.wealth.value}}"></dd>
      </dl>
      <h3>Saves</h3>
      <dl class="m20-stats">
        {{#each saves}}<dt>{{label}}</dt><dd class="m20-strong" data-tooltip="Base {{base}}">{{total}}</dd>{{/each}}
      </dl>
    </div>
  </div>

  <div class="m20-panel">
    <h3>Classes</h3>
    {{#each classes}}
      <div class="m20-class" data-item-id="{{id}}">
        <img src="{{img}}" alt="" width="32" height="32">
        <a class="m20-item-name" data-action="editItem">{{name}}</a>
        <label>Level <input type="number" min="1" max="{{max}}" value="{{level}}" data-item-field="level"></label>
        <span class="m20-rolls">HP (d{{hitDie}}):
          {{#each rolls}}<input type="number" min="1" value="{{value}}" placeholder="—" data-item-field="hitPoints" data-index="{{index}}">{{/each}}
        </span>
        <a data-action="deleteItem" data-tooltip="Remove"><i class="fa-solid fa-trash"></i></a>
      </div>
    {{else}}
      <p class="m20-hint">Drag a class from the Classes compendium onto this sheet.</p>
    {{/each}}
  </div>
</section>
