<section class="tab {{tab.cssClass}}" data-tab="{{tab.id}}" data-group="{{tab.group}}">
  {{#if (and grants.length @root.freeEdit)}}
    <div class="m20-panel">
      <h3>Feats you are given</h3>
      {{#each grants}}
        <div class="m20-grant">
          <p class="{{#if over}}m20-warning{{else}}m20-hint{{/if}}">{{text}} ({{taken}} of {{choose}} taken).</p>
          {{#each options}}<label><input type="checkbox" data-action="toggleGrant" data-source="{{../source}}" data-index="{{index}}" {{#if checked}}checked{{/if}}> {{label}}</label>{{/each}}
        </div>
      {{/each}}
    </div>
  {{/if}}
  {{#if @root.freeEdit}}{{#each classChoices}}
    <div class="m20-panel m20-class-choices">
      <h3>{{name}}</h3>
      {{#if talents}}
        <p class="{{#if talents.over}}m20-warning{{else}}m20-hint{{/if}}">Talents: {{talents.taken}} of {{talents.slots}} taken.</p>
        {{#each talents.trees}}
          <div class="m20-tree"><strong>{{name}}</strong>
            {{#each talents}}
              <label class="{{#if unmet}}m20-unmet{{/if}}" {{#if unmet}}data-tooltip="Needs {{unmet}}"{{/if}}{{#if check}}data-tooltip="Check by hand: {{check}}"{{/if}}>
                <input type="checkbox" data-action="toggleTalent" data-name="{{name}}" data-uuid="{{uuid}}" {{#if unmet}}data-unmet="{{unmet}}"{{/if}} {{#if checked}}checked{{/if}}> {{name}}{{#if check}} <i class="fa-solid fa-circle-question"></i>{{/if}}
              </label>
            {{/each}}
          </div>
        {{/each}}
      {{/if}}
      {{#if bonus}}
        <details class="m20-bonus-feats" {{#if bonus.slots}}open{{/if}}>
          <summary class="{{#if bonus.over}}m20-warning{{else}}m20-hint{{/if}}">Bonus feats: {{bonus.taken}} of {{bonus.slots}} taken, from this list</summary>
          {{#each bonus.options}}
            <label {{#if have}}{{#unless checked}}data-tooltip="You have this feat; tick to count it as a bonus feat"{{/unless}}{{/if}}><input type="checkbox" data-action="toggleBonusFeat" data-class="{{../id}}" data-index="{{index}}" {{#if checked}}checked{{/if}}> {{label}}{{#if have}}{{#unless checked}} <i class="fa-solid fa-check m20-hint"></i>{{/unless}}{{/if}}</label>
          {{/each}}
        </details>
      {{/if}}
    </div>
  {{/each}}{{/if}}
  {{#if (and (eq tab.id "gear") @root.combat.load)}}<p class="{{#if @root.combat.load.warn}}m20-warning{{else}}m20-hint{{/if}}" data-tooltip="{{@root.combat.load.tip}}">{{@root.combat.load.text}}</p>{{/if}}
  {{#each lists}}
    <div class="m20-panel">
      <h3>{{label}}{{#if count}} <span class="{{#if count.over}}m20-warning{{else}}m20-hint{{/if}}" data-tooltip="{{count.parts}}">{{count.text}}</span>{{/if}}</h3>
      {{#each items}}
        <div class="m20-item" data-item-id="{{id}}">
          <img src="{{img}}" alt="" width="28" height="28">
          <a class="m20-item-name" data-action="editItem" {{#if origin}}data-tooltip="{{origin}}"{{/if}}>{{name}}</a>
          {{#if twice}}<i class="fa-solid fa-triangle-exclamation m20-warning" data-tooltip="{{twice}}"></i>{{/if}}
          {{#if unmet}}<i class="fa-solid fa-circle-exclamation m20-warning" data-tooltip="{{unmet}}"></i>{{/if}}
          {{#if choiceKind}}<input class="m20-choice" type="text" value="{{choice}}" placeholder="Choose a {{choiceKind}}" data-item-field="choice" data-tooltip="The {{choiceKind}} this was taken for">{{/if}}
          <span class="m20-item-detail">{{detail}}</span>
          {{#if ammo}}
            <span class="m20-ammo">
              {{#if ammo.magazine}}<input type="number" min="0" max="{{ammo.capacity}}" value="{{ammo.loaded}}" data-item-field="loaded" data-tooltip="Rounds loaded">/{{ammo.capacity}}{{#if ammo.loadedWith}} <span class="m20-tag" data-tooltip="Loaded with: its effect is on every shot. Reload from other ammunition to change it">{{ammo.loadedWith}}</span>{{/if}}
                <a data-action="reload" data-tooltip="Reload from its ammunition"><i class="fa-solid fa-rotate"></i></a>{{/if}}
              {{#unless ammo.none}}<select data-item-field="ammunition" data-tooltip="The ammunition it uses">{{#each ammo.options}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/unless}}
            </span>
          {{/if}}
          {{#if special}}<input class="m20-choice" type="text" value="{{caliber}}" placeholder="Caliber" list="m20-calibers" data-item-field="caliber" data-tooltip="The caliber this load was bought in (12-gauge, 9mm): it fits that gun">{{/if}}
          {{#if counted}}<input class="m20-quantity" type="number" min="0" value="{{quantity}}" data-item-field="quantity" data-tooltip="Rounds carried">{{/if}}
          {{#if weapon}}<a data-action="rollAttack" data-tooltip="Attack"><i class="fa-solid fa-dice-d20"></i></a><a data-action="rollDamage" data-tooltip="Damage"><i class="fa-solid fa-burst"></i></a>{{/if}}
          {{#if dc}}<a data-action="buyItem" data-tooltip="Buy: a Wealth check against purchase DC {{dc}}"><i class="fa-solid fa-cart-shopping"></i></a><a data-action="sellItem" data-tooltip="Sell for Wealth, and remove it"><i class="fa-solid fa-money-bill"></i></a>{{/if}}
          {{#if physical}}<a data-action="toggleEquipped" class="{{#if equipped}}m20-on{{/if}}" data-tooltip="{{#if equipped}}Equipped{{else}}Not equipped{{/if}}"><i class="fa-solid fa-shirt"></i></a>
            <a data-action="toggleStored" class="{{#if stored}}m20-on{{/if}}" data-tooltip="{{#if stored}}Kept elsewhere: not carried, so not in your load{{else}}Carried: in your load{{/if}}"><i class="fa-solid fa-box-archive"></i></a>{{/if}}
          <a data-action="deleteItem" data-tooltip="Remove"><i class="fa-solid fa-trash"></i></a>
        </div>
        {{#if (and occupation @root.freeEdit)}}
          <div class="m20-occupation-skills" data-item-id="{{id}}">
            <p class="{{#if occupation.over}}m20-warning{{else}}m20-hint{{/if}}">Choose {{occupation.choose}} as permanent class skills ({{occupation.count}} chosen). One that is already a class skill gives +1 instead.{{#if occupation.languages}} {{occupation.languages}}{{/if}}</p>
            {{#each occupation.options}}
              <label><input type="checkbox" data-item-field="chosenSkill" data-value="{{label}}" {{#if checked}}checked{{/if}}> {{label}}</label>
            {{/each}}
          </div>
        {{/if}}
      {{else}}
        <p class="m20-hint">None. Drag from a compendium onto this sheet.</p>
      {{/each}}
    </div>
  {{/each}}
  {{#if (eq tab.id "gear")}}<datalist id="m20-calibers">{{#each calibers}}<option value="{{this}}"></option>{{/each}}</datalist>{{/if}}
</section>
