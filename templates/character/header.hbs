<header class="m20-header">
  <img class="m20-portrait" src="{{actor.img}}" data-action="editImage" data-edit="img" data-tooltip="Change portrait" alt="{{actor.name}}" width="96" height="96">
  <div class="m20-identity">
    <input class="m20-name" type="text" name="name" value="{{actor.name}}" placeholder="Name">
    <div class="m20-tags">
      <span class="m20-tag">Level {{d.level}}</span>
      <span class="m20-tag">{{summary}}</span>
      <span class="m20-tag">{{size}}</span>
    </div>
  </div>
  <div class="m20-vitals">
    <div class="m20-vital">
      <span class="m20-vital-label">Hit Points</span>
      <span class="m20-vital-value">
        <input type="number" name="system.hp.value" value="{{system.hp.value}}">
        <span class="m20-vital-max">/ {{combat.hpMax}}{{#if combat.hpEstimated}}<i class="fa-solid fa-circle-question" data-tooltip="Some levels have no hit point roll yet and count the average"></i>{{/if}}</span>
      </span>
    </div>
    <div class="m20-vital">
      <span class="m20-vital-label">Temp</span>
      <span class="m20-vital-value"><input type="number" name="system.hp.temp" value="{{system.hp.temp}}"></span>
    </div>
    <div class="m20-vital">
      <span class="m20-vital-label">Action Points</span>
      <span class="m20-vital-value"><input type="number" name="system.actionPoints.value" value="{{system.actionPoints.value}}"></span>
    </div>
  </div>
</header>
