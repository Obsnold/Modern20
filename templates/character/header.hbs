<div class="m20-top">
<header class="m20-header">
  <img class="m20-portrait" src="{{actor.img}}" data-action="editImage" data-edit="img" data-tooltip="Change portrait" alt="{{actor.name}}" width="96" height="96">
  <div class="m20-identity">
    <input class="m20-name" type="text" name="name" value="{{actor.name}}" placeholder="Name">
    <div class="m20-tags">
      <span class="m20-tag">Level {{d.level}}</span>
      <span class="m20-tag">{{summary}}</span>
      <span class="m20-tag">{{size}}</span>
    </div>
  </div>
</header>
<div class="m20-vitals">
  <label class="m20-vital">
    <span class="m20-vital-label">Current HP</span>
    <input type="number" name="system.hp.value" value="{{system.hp.value}}">
  </label>
  <div class="m20-vital" data-tooltip="From your class levels' hit point rolls, Constitution and feats">
    <span class="m20-vital-label">Max HP{{#if combat.hpEstimated}} <i class="fa-solid fa-circle-question" data-tooltip="Some levels have no hit point roll yet and count the average"></i>{{/if}}</span>
    <span class="m20-vital-number">{{combat.hpMax}}</span>
  </div>
  <label class="m20-vital" data-tooltip="Temporary hit points from spells and effects: lost first, and gone when the effect ends">
    <span class="m20-vital-label">Temp HP</span>
    <input type="number" name="system.hp.temp" value="{{system.hp.temp}}">
  </label>
  <label class="m20-vital">
    <span class="m20-vital-label">Action Points</span>
    <input type="number" name="system.actionPoints.value" value="{{system.actionPoints.value}}">
  </label>
</div>
</div>
