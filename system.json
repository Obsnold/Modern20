{
  "id": "modern20",
  "title": "Modern20",
  "description": "<p>A Foundry VTT game system implementing the d20 Modern System Reference Document: basic and advanced classes, talent trees, occupations, Defense, Reputation, action points, massive damage, and the Wealth economy.</p><p>This system includes Open Game Content released under the Open Game License v1.0a. See OPEN_GAME_LICENSE.md.</p>",
  "version": "0.1.0",
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "authors": [
    { "name": "Terry" }
  ],
  "esmodules": ["module/modern20.mjs"],
  "styles": ["css/modern20.css"],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" }
  ],
  "documentTypes": {
    "Actor": {
      "hero": { "htmlFields": ["biography"] },
      "ordinary": { "htmlFields": ["biography"] },
      "creature": { "htmlFields": ["biography"] },
      "vehicle": { "htmlFields": ["description"] }
    },
    "Item": {
      "class": { "htmlFields": ["description"] },
      "occupation": { "htmlFields": ["description"] },
      "talent": { "htmlFields": ["description"] },
      "feat": { "htmlFields": ["description", "benefit", "normal", "special"] },
      "weapon": { "htmlFields": ["description"] },
      "armor": { "htmlFields": ["description"] },
      "gear": { "htmlFields": ["description"] },
      "vehicleMod": { "htmlFields": ["description"] },
      "spell": { "htmlFields": ["description"] },
      "psiPower": { "htmlFields": ["description"] }
    }
  },
  "packs": [],
  "grid": { "distance": 5, "units": "ft" },
  "primaryTokenAttribute": "hp",
  "url": "https://github.com/YOURNAME/modern20",
  "manifest": "https://raw.githubusercontent.com/YOURNAME/modern20/main/system.json",
  "download": "https://github.com/YOURNAME/modern20/archive/refs/tags/v0.1.0.zip",
  "license": "LICENSE.md",
  "readme": "README.md",
  "bugs": "https://github.com/YOURNAME/modern20/issues"
}
