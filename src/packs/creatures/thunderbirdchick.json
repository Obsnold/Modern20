      "name": "Fear Aura (DC 13)",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/terror.svg",
      "system": {
        "description": "<p>Any creature within 60 feet of a thunderbird must succeed on a @Check[save:will]{Will save} (DC 10 + 1/2 the thunderbird’s Hit Dice + its Charisma modifier) or be shaken for 1d4 rounds. Whether or not the save is successful, that creature cannot be affected again by that thunderbird’s fear aura for 24 hours.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
