      "_id": "f5P0Q0RwQoXrPy6h",
      "name": "Breath Weapon (2d10; DC 13)",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/dragon-breath.svg",
      "system": {
        "description": "<p>Every 1d4 rounds, a thunderbird can breathe a 60-foot-long cone of sonic energy as an attack action. Any creature in the cone takes 1d10 points of sonic damage per 2 Hit Dice of the thunderbird (8d10 for the typical adult specimen). A successful @Check[save:ref]{Reflex save} (DC 10 + 1/2 the thunderbird’s Hit Dice + its Constitution modifier) halves the damage.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
        "abilityType": "supernatural",
