      "name": "Improved Grab",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/grab.svg",
      "system": {
        "description": "<p>To use this ability, the thunderbird must hit a single opponent at least two size categories smaller than itself with both claw attacks in the same round. If it gets a hold, it automatically deals damage for two claw attacks and a bite attack each round that the hold is maintained.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat4.html",
