      "_id": "6ilEFTJ22iKChuTo",
      "name": "Acidic Enzymes",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>Any creature that takes damage from a Crawfordsville monster’s slam attack also takes 1d6 points of acid damage from its digestive enzymes. These enzymes continue to dissolve the victim even after the attack, dealing 1d6 points of acid damage each round until the wound is washed with at least 1 pint of water (or some other appropriate liquid).</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat1.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
        "abilityType": "extraordinary",
