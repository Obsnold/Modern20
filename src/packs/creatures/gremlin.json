      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>When making a @Check[skill:disableDevice]{Disable Device check}, a gremlin completely disassembles the device if the check result is 5 or more higher than the DC of the skill check. Reassembling the device requires a successful @Check[skill:repair]{Repair check} against a DC equal to the gremlin\u2019s @Check[skill:disableDevice]{Disable Device check} result.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst2.html",
