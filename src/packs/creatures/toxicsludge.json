      "_id": "OwqYE61G7DOeQwmu",
      "name": "Acid",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A toxic sludge is composed of caustic chemicals that dissolve any substance except stone and metal. A toxic sludge’s slam attack deals 1d4 points of acid damage in addition to the normal bludgeoning damage.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
        "abilityType": "extraordinary",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!Gir1NtFWGE4Zc214.OwqYE61G7DOeQwmu"
    },
    {
      "_id": "qQ26j0VmfxMmUxHn",
      "name": "Blindsight",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A toxic sludge is blind but can ascertain all creatures and objects within 40 feet just as a sighted creature would. Beyond that range, all targets have total concealment with respect to the toxic sludge.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
        "abilityType": "extraordinary",
