      "name": "Scent",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/third-eye.svg",
      "system": {
        "description": "<p>This ability allows a werewolf in wolf or hybrid form to detect approaching enemies, sniff out hidden foes, and track by sense of smell.</p>",
