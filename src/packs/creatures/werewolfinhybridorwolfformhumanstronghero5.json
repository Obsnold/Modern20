    {
      "_id": "FYN4UKmTiAHIoYoo",
      "name": "Damage Reduction 15/Silver",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/shield-reflect.svg",
      "system": {
        "description": "<p>A werewolf in wolf or hybrid form ignores the first 15 points of damage dealt by a nonsilver or nonmagical weapon but takes full damage from silvered weapons or weapons with a +1 or better magic bonus.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/creatures4.html",
