    {
      "_id": "9WqePSW3MolxbvpQ",
      "name": "Special Combat Bonuses",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>Dwarves gain a +1 species bonus on attack rolls against bugbears, goblins, orcs, and other goblinoids. Dwarves also gain a +4 dodge bonus to Defense against creatures of the giant type. If a dwarf loses his positive Dexterity bonus to Defense (such as when flatfooted), this dodge bonus is lost.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst1.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
        "abilityType": "",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!gsgiZyahre8eA61m.9WqePSW3MolxbvpQ"
    },
    {
      "_id": "1oRKS31jhWA10AuT",
      "name": "Stability",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>Dwarves gain a +4 species bonus on ability checks to resist bulll rush and trip attempts when standing on the ground (but not when climbing, flying, riding, or otherwise not standing firmly on the ground).</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst1.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
        "abilityType": "",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!gsgiZyahre8eA61m.1oRKS31jhWA10AuT"
    },
    {
      "_id": "UdS6WFOnyp0TKzqN",
      "name": "Darkvision 60 ft.",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/third-eye.svg",
      "system": {
        "description": "<p>Dwarves can see in the dark up to 60 feet. Darkvision is black and white only, but it is otherwise like normal sight, and dwarves can function with no light at all.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst1.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
        "abilityType": "extraordinary",
        "sense": true,
        "activities": {}
      },
      "_key": "!actors.items!gsgiZyahre8eA61m.UdS6WFOnyp0TKzqN"
    },
    {
      "_id": "rJiFWe5XHZrjTXwU",
      "name": "Speed",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>Dwarves have a base speed of 20 feet. However, dwarves can move at this speed even when wearing medium or heavy armor or when carrying a medium or heavy load (unlike other creatures, whose speed is reduced in such situations).</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst1.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
        "abilityType": "",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!gsgiZyahre8eA61m.rJiFWe5XHZrjTXwU"
    },
    {
      "_id": "YnyjnphhHZntvP6h",
      "name": "Saving Throw Bonuses",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>Dwarves are highly resistant to toxins and innately resistant to magic. They gain a +2 species bonus on saving throws against poisons, spells, and spell-like abilities.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst1.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
        "abilityType": "",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!gsgiZyahre8eA61m.YnyjnphhHZntvP6h"
    },
    {
      "_id": "D47FAFt9zSwFVYIv",
      "name": "Skill Bonuses",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>Dwarves gain a +2 species bonus on @Check[skill:search]{Search check}s to notice unusual stonework, new construction, unsafe surfaces, ceilings, and the like. A dwarf who merely passes within 10 feet of such exceptional construction can, as a free action, make a @Check[skill:search|dc:15]{Search check (DC 15)} as though he were actively searching for such.</p><p>Dwarves are naturally skilled mechanics and engineers. They gain a +2 species bonus on Craft (mechanical), Craft (structural), and @Check[skill:repair]{Repair check}s.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst1.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
        "abilityType": "",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!gsgiZyahre8eA61m.D47FAFt9zSwFVYIv"
    },
    {
      "_id": "vr6QRYwSMUuONPGd",
      "name": "Bonus Feat",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>Dwarves gain the bonus feat Archaic Weapons Proficiency. Dwarves may treat dwarven urgroshes and dwarven waraxes as archaic weapons instead of exotic weapons.</p><p>Questions? Comments? Boredome? Spot a typoe or a broken link? If you have any of these, feel free to send me an e-mail message at</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst1.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
