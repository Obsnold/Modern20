    {
      "_id": "WyhllslNXrvryUrI",
      "name": "Dance of Ruin",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/magic-swirl.svg",
      "system": {
        "description": "<p>To use this ability, a group of five or more vrocks join hands in a circle, dancing wildly and chanting. If they dance for 3 rounds, a wave of crackling energy flashes outward in a 100-foot radius. All creature within the radius take 2d20 points of electricity damage (to which vrocks are immune); a successful @Check[save:ref|dc:15]{Reflex save (DC 15)} halves the damage. Forcing the vrocks to break the circle stops the dance.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
