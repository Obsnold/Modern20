      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/magic-swirl.svg",
      "system": {
        "description": "<p>Once per hour, a vrock can emit a piercing screech. Every creature within a 30-foot radius must succeed at a @Check[save:fort]{Fortitude save} (DC 10 + 1/2 vrock\u2019s Hit Dice + vrock\u2019s Constitution modifier) or be stunned for 1 round.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
