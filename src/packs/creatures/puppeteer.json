    {
      "_id": "SPOoY29pR7zahxUc",
      "name": "Psionics",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>3/day—brain lock, lesser domination. These abilities are as the psionic powers of an 8th-level manifester.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/creatures3.html",
        "abilityType": "spellLike",
        "sense": false,
