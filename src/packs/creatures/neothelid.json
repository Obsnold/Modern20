    {
      "_id": "LFMsHRSngeLN0TQ0",
      "name": "Blindsight 500 ft.",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>A neothelid is blind but can ascertain all creatures and objects within 500 feet by nonvisual means. Beyond that range, all targets have total concealment with respect to the neothelid.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat3.html",
