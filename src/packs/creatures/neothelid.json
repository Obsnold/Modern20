    {
      "_id": "yss5n6rdRybeF9WV",
      "name": "Breath Weapon (DC 30)",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/dragon-breath.svg",
      "system": {
        "description": "<p>Once every 1d4 rounds, a neothelid can breathe a 50-foot cone of acid that deals 14d10 points of acid damage to every creature in its area. A successful @Check[save:ref]{Reflex save} (DC 10 + 1/2 the neothelid\u2019s Hit Dice + its Constitution modifier) halves the damage.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat3.html",
