    {
      "_id": "JVZa5dEVkLycneHt",
      "name": "Energy Claw",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>In addition to its base damage, a Montauk monster’s claw attack deals 1d6 points of electricity damage and 1d6 points of fire damage with a successful hit.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat3.html",
        "abilityType": "extraordinary",
        "sense": false
      }
    },
    {
      "_id": "GZj6pPL8fdJ68M77",
      "name": "Energy Form",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Montauk monsters are raw energy given sentience. Their bodies and their melee attacks are force effects.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat3.html",
        "abilityType": "extraordinary",
        "sense": false
      }
    },
    {
      "_id": "mlR5qwD6AGA0TGas",
      "name": "Fast Healing 3",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A montauk monster heals 3 points of damage per round unless it is reduced to –10 or fewer hit points. This ability does not enable a montauk monster to regrow or reattach severed body parts.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat3.html",
        "abilityType": "extraordinary",
        "sense": false
      }
    },
    {
      "_id": "9Sof4ZYgPJaJ9qvs",
      "name": "Fire Subtype",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A montauk monster is immune to fire damage and takes 50% more damage from cold attacks.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat3.html",
        "abilityType": "extraordinary",
        "sense": false
      }
    },
    {
      "_id": "vEK9QE2689R6LM66",
      "name": "Fuse (DC 15)",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Once every 1d4 rounds, a montauk monster can cause a creature it has successfully hit with a melee attack to fuse with nearby matter. At the time of the attack, the target creature must be within 5 feet of a solid object with a volume at least equal to its own. (In most cases, the ground or a wall is sufficient.) The target must succeed at a Will saving throw (DC 10 + 1/2 the montauk monster’s Hit Dice + its Charisma modifier) or be fused with the object and instantly killed. The object’s hardness drops by 2 after the fusion, regardless of the creature’s nature or physical makeup. Such an object continues to function normally, but it is usually cosmetically grotesque, with fleshy fingers or a portion of a face projecting from its surface.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat3.html",
        "abilityType": "supernatural",
        "sense": false
      }
    },
    {
      "_id": "n8Lyltje4S1LTc2D",
      "name": "Immunities",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Montauk monsters are immune to fire and electricity. They are also immune to force effects such as mage armor, magic missile, and wall of force. The creatures and their melee attacks pass through such effects unharmed and unhindered.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat3.html",
        "abilityType": "extraordinary",
        "sense": false
      }
    },
    {
      "_id": "xvbgyMMyCf9gpUF5",
      "name": "Invisibility",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A montauk monster is naturally invisible, as though constantly under the effect of the invisibility spell (caster level 10th). Like a subject of that spell, the monster becomes visible upon attacking, but it can reinstate its invisibility as a free action once per round.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat3.html",
        "abilityType": "supernatural",
        "sense": false
      }
    }
