      "system": {
        "description": "<p>A viper injects venom with a successful bite. The victim must succeed on a Fortitude save or take 1d6 points of temporary Constitution damage; a second Fortitude save must be made 1 minute later to negate the venom’s secondary damage (same as the initial damage). The save DC is equal to 11 + 1/2 the snake’s Hit Dice + the snake’s Constitution modifier (DC 11 for a Tiny viper).</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/animals.html",
        "abilityType": "extraordinary",
        "sense": false
      }
