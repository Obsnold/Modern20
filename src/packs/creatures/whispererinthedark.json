    {
      "_id": "BWIBXz34xNTRs3su",
      "name": "Daylight Powerlessness",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>A whisperer in the dark is utterly powerless in natural sunlight and flees from it if possible. If caught in sunlight, it cannot attack and may make only one move or attack action each round. It cannot take full-round actions at all in this situation.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
        "abilityType": "extraordinary",
        "sense": false,
        "activities": {}
      },
