    {
      "_id": "lAdJcELe2z8kACXL",
      "name": "Psionics",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/telepathy.svg",
      "system": {
        "description": "<p>At will—attraction, clairaudience/clairvoyance, concussion, detect psionics, suggestion. Manifester level 10th; save DC 10 + whisperer in the dark’s key ability modifier + power level.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat4.html",
