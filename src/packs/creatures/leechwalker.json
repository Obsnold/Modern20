      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A leechwalker can drink the blood of a grabbed victim with a successful grapple check. This attack deals 2d4 points of Constitution damage.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst2.html",
