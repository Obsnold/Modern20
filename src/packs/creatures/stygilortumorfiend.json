    {
      "_id": "BOnsOfJA8Rf4uWfL",
      "name": "Frightful Presence (DC 15)",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A stygilor can use the Frightful Presence feat once per round as a free action. All creatures within 10 feet that can see the stygilor and have fewer levels or Hit Dice than the stygilor must succeed at a Will save (DC 10 + 1/2 the stygilor’s Hit Dice + its Charisma modifier) or take a –2 penalty on attack rolls, saving throws, and skill checks for 1d6+2 rounds. A successful save grants immunity to the stygilor’s frightful presence for 24 hours. Creatures with an Intelligence of 3 or lower are unaffected. This is a mind-affecting ability.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat2.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.m2Ee3GBz7FC2xPtC",
