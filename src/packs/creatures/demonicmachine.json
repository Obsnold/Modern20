      "_id": "TTooEvC09Y35IUq2",
      "name": "Construct",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A demonic machine has the traits and immunities common to constructs. Unlike most constructs, however, it has an Intelligence score supplied by the demonic force that animates it.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat1.html",
        "abilityType": "",
        "sense": false
      }
