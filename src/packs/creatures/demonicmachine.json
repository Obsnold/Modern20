      "name": "Grind (2d6+5)",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A demonic machine may make a grind attack (at its normal attack bonus) against a grappled creature, dealing double claw damage plus its Strength modifier.</p>",
