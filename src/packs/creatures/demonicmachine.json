      "_id": "SPy9Wh8K2RRKI93T",
      "name": "Damage Reduction 10/+1",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A demonic machine ignores the first 10 points of damage dealt by any nonmagical weapon. In campaigns without magic weapons, the GM can either disregard the demonic machine’s damage reduction or apply it only to certain types of weapons (ballistic, bludgeoning, piercing, slashing, or sonic/concussion).</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat1.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
        "abilityType": "supernatural",
        "sense": false,
