      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A fire wisp can detect the electrical currents in and around creatures and objects within 60 feet. This perception reveals their locations as accurately as normal vision would. Beyond that range, all targets have total concealment with respect to the fire wisp.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat2.html",
