      "img": "systems/modern20/assets/icons/lorc/shield-reflect.svg",
      "system": {
        "description": "<p>A giant man-\u2019o-war ignores the first 5 points of damage dealt by any nonpiercing weapon.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat3.html",
