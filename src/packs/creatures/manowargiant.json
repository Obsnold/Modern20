      "name": "Paralysis",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>The strands of a giant man-\u2019o-war secrete an anesthetizing slime. Any target hit by its strand attack must succeed on a @Check[save:fort]{Fortitude save} (DC 10 + 1/2 the man-\u2019owar\u2019s Hit Dice + its Constitution modifier) or be paralyzed for 3d6 rounds. The man-\u2019o-war can automatically bite a paralyzed opponent.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat3.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
