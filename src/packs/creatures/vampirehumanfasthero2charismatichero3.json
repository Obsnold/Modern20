    {
      "_id": "TbrffFgh6TRBM6Uj",
      "name": "Alternate Form",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/magic-swirl.svg",
      "system": {
        "description": "<p>A vampire can assume the form of a bat, rat, or wolf as a move action. The vampire can remain in that form until it assumes another form or until the next sunrise.</p>",
