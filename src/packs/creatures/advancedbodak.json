      "name": "Sunlight Vulnerability",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>The merest touch of sunlight sears a bodak’s tainted alien flesh. Each round of exposure to the direct rays of the sun deals 1 point of damage to the creature.</p>",
