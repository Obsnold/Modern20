    {
      "_id": "j3VEdQ7LaswXosyK",
      "name": "Impale",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>A murdergaunt that hits with one of its armspikes may choose to impale its opponent. An impaled opponent takes armspike damage each round it remains impaled (on the murdergaunt\u2019s turn). An impaled creature must tear free of the serrated armspike to move to another square, taking 1d6 points of damage in the process. A murdergaunt must tear its armspike from an impaled opponent to move to another square or to free the limb; pulling free the armspike deals an automatic 1d6 points of damage to the impaled creature, but the murdergaunt cannot use the newly freed armspike to attack that round.</p><p>A murdergaunt can impale two Medium-size or smaller creatures at the same time; however, it cannot make an attack (or attack of opportunity) with an armspike that is currently impaling a foe.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat2.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
        "abilityType": "extraordinary",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!JfTuImoEKsTDQfN9.j3VEdQ7LaswXosyK"
    },
    {
