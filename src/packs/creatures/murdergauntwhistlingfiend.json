      "name": "Telepathy",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/magic-swirl.svg",
      "system": {
        "description": "<p>A murdergaunt can communicate telepathically with any creature within 100 feet that has a language.</p>",
        "source": "Menace Manual",
