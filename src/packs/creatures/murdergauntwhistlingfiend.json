    {
      "_id": "3qIu1xMHJ35qwVnI",
      "name": "Whistle (DC 16)",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/magic-swirl.svg",
      "system": {
        "description": "<p>A murdergaunt can whistle as a free action every round. Creatures within 120 feet who can hear the murdergaunt\u2019s horrid tune must make a @Check[save:will]{Will save} (DC 10 + 1/2 the murdergaunt\u2019s Hit Dice + its Charisma modifier).</p><p>Any creature that fails its @Check[save:will]{Will save} cowers until the whistling stops. A cowering creature is frozen in fear, loses its Dexterity bonus, and can take no actions. In addition, a cowering creature takes a \u20132 penalty to Defense.</p><p>A creature that saves against the murdergaunt\u2019s whistle cannot be affected by the same murdergaunt\u2019s whistle for 24 hours. The save DC for the whistle is Charisma-based.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat2.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
        "abilityType": "supernatural",
        "sense": false,
        "activities": {
          "save": {
            "type": "save",
            "name": "Whistle",
            "actionType": "free",
