    {
      "_id": "d3zc4DFTOttHYtmD",
      "name": "Tree Dependent",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/magic-swirl.svg",
      "system": {
        "description": "<p>Each dryad is mystically bound to a single, enormous tree, or a copse of trees situated in one place (such as a lobby atrium) and must never stray more than 300 yards from it. Any who do stray from their trees become ill and die within 4d6 hours. A dryad’s tree does not radiate magic.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst1.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
        "abilityType": "supernatural",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!PY9lAcDQbCF1To55.d3zc4DFTOttHYtmD"
    },
    {
      "_id": "LCfC5xKAwNleJhwI",
      "name": "Wild Empathy",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>A dryad can use body language, vocalizations, and demeanor to improve the attitude of an animal. This ability functions like a @Check[skill:diplomacy]{Diplomacy check} made to improve the attitude of a person. The dryad rolls 1d20 +10 (+6 species bonus, +4 Charisma bonus) to determine the wild empathy check result. The typical domestic animal has a starting attitude of indifferent, while wild animals are usually unfriendly.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst1.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
        "abilityType": "extraordinary",
