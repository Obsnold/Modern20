    {
      "_id": "SY2YBGWmbgYGJH0c",
      "name": "Construct",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>Retrievers are immune to mind-influencing effects as well as poison, sleep, paralysis, stunning, disease, necromancy effects, and any effect that requires a @Check[save:fort]{Fortitude save} unless the effect also works on objects or is harmless. They are not subject to critical hits, nonlethal damage, ability damage, ability drain, energy drain, or the effects of massive damage.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst3.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
