      "name": "Fast Healing 5",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/delapouite/healing.svg",
      "system": {
        "description": "<p>A bogeyman heals 5 points of damage per round until it is reduced to its negative Constitution score, at which point it dies. This ability does not enable the bogeyman to regrow or reattach severed body parts.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat1.html",
