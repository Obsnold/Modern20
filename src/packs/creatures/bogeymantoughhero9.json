      "name": "Death\u2019s Door",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/magic-swirl.svg",
      "system": {
        "description": "<p>A bogeyman appears to die if reduced to \u201310 hit points. However, unless it is reduced to its negative Constitution score in hit points, its \u201cdeath\u201d is only temporary; when the bogeyman\u2019s fast healing ability (see below) brings its hit point total to 1 or higher, it springs back to life.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat1.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
        "abilityType": "supernatural",
