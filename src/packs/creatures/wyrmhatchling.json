    {
      "_id": "NA131dGLS7vtrtVo",
      "name": "Improved Grab",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/grab.svg",
      "system": {
        "description": "<p>To use this ability, a wyrm must hit with both claw attacks. If it gets a hold, it hangs on and stings. If a wyrm grabs a creature two or more size categories smaller, it automatically deals damage with both claws and its sting each round the hold is maintained. See Improved Grab.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/creatures4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.y98NYAYGT9GM5Mox.JournalEntryPage.Gz87IPdigtsYQV9G",
