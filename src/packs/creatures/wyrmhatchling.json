      "system": {
        "description": "<p>A creature stung by a wyrm must succeed on a @Check[save:fort|dc:25]{Fortitude save (DC 25)} or take 2d6 points of temporary Constitution damage. After 1 minute has elapsed, the creature must succeed on a second save (DC 25) or take another 2d6 points of temporary Constitution damage.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/creatures4.html",
