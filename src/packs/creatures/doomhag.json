    {
      "_id": "0UJsHhdeMlIUq8jU",
      "name": "Natural Invisibility",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>During daylight, a doom hag is naturally invisible and remains so even when attacking. Any creature that correctly discerns the doom hag’s location despite being unable to see it has a 50% miss chance on melee and ranged attacks. This ability is always active, but the doom hag can suppress it for 1 round with a successful Concentration check (DC 15). A new check at the same DC is required for each subsequent round that it wishes to remain visible. The doom hag is visible from sundown to sunup.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat1.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.TB1nov8Jp7M8R173",
        "abilityType": "supernatural",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!FZ7KtQJr2WG0yIEx.0UJsHhdeMlIUq8jU"
    },
