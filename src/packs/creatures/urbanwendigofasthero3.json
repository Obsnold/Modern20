      "name": "Ferocity",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>An urban wendigo is such a tenacious combatant that it continues to fight without penalty even while disabled or dying.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
