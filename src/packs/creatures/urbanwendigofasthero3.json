    {
      "_id": "Tb0fV7XeEs1tJpFN",
      "name": "Peripheral Invisibility",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/magic-swirl.svg",
      "system": {
        "description": "<p>A side effect of the desolation that created the urban wendigo in the first place, the urban wendigo gains the benefit of invisibility, as the spell cast by a 10th-level Mage. By staying out of the direct, focused vision of city dwellers, the urban wendigo can roam the city unseen. Unlike the invisibility spell, any character looking in the general direction of the urban wendigo and taking an attack action to make a @Check[skill:spot]{Spot check} (DC = the urban wendigo’s @Check[skill:hide]{Hide check}) can see the urban wendigo if the check succeeds. Once a character sees an urban wendigo, that character is immune to its peripheral invisibility for 1 hour.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
        "abilityType": "supernatural",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!QQV24kKqHJDItjSu.Tb0fV7XeEs1tJpFN"
    },
    {
      "_id": "DVfiYp1jB6MR0wYJ",
      "name": "Scent",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/third-eye.svg",
      "system": {
        "description": "<p>This ability allows the urban wendigo to detect approaching enemies, sniff out hidden foes, and track by scent.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
        "abilityType": "extraordinary",
