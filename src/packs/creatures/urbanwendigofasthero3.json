      "name": "Low-Light Vision",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/third-eye.svg",
      "system": {
        "description": "<p>Urban wendigos can see twice as far as a human in starlight, moonlight, torchlight, and similar conditions of poor illumination. They retain the ability to distinguish color and detail under these conditions.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
