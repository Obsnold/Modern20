    {
      "_id": "8ZZmJ5wGyIR0AfB6",
      "name": "Rage",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>An urban wendigo that takes damage in combat flies into a berserk rage the following round, clawing and biting madly until either it or its opponent is dead. An enraged urban wendigo gains +4 Strength and +4 Constitution, and takes a –2 penalty Defense. The creature cannot end its rage voluntarily.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
        "abilityType": "extraordinary",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!QQV24kKqHJDItjSu.8ZZmJ5wGyIR0AfB6"
    },
    {
      "_id": "GeDvglGpROc59sg8",
      "name": "Rend 2d6+9",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>If an urban wendigo hits with both claw attacks, it latches onto the opponent’s body and tears the flesh. This attack automatially deals an additional 2d6+9 points of damage.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
