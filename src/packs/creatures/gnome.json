    {
      "_id": "ymbaJgloX0xvFIZJ",
      "name": "Speak with Animals 1/day",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/scroll-unfurled.svg",
      "system": {
        "description": "<p>Once per day, a gnome can use speak with animals as a spell-like ability to speak with a burrowing mammal (a mole, gopher, ground hog, and so forth). It has a duration of 1 minute, and the gnome is considered a 1st-level caster when he uses this ability, regardless of his actual level.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst2.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
        "abilityType": "spellLike",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!0OXyjUlwKFnSyKPh.ymbaJgloX0xvFIZJ"
    },
    {
      "_id": "rrFsNxExsOfUygJX",
      "name": "Low-Light Vision",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/third-eye.svg",
      "system": {
        "description": "<p>Gnomes can see twice as far as a human in starlight, moonlight, torchlight, and similar conditions of poor illumination. They retain the ability to distinguish color and detail under these conditions.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst2.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
