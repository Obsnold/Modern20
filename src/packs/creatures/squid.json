      "name": "Ink Cloud",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Both the squid and giant squid can emit a cloud of jet-black ink as a free action. The squid’s ink cloud fills a 10-foot cube, while the giant squid’s ink cloud fills a 20-foot cube. The cloud provides total concealment, which the squid normally uses to escape a losing fight. All vision within the cloud is obscured.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
