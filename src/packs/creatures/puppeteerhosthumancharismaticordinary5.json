    },
    {
      "_id": "bVQ57RWgDEFL3yEY",
      "name": "Host Protection",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>An attached puppeteer uses its host’s base saving throw bonuses if they’re better than its own. Effects that target vermin can’t affect a puppeteer riding a humanoid host.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/creatures3.html",
