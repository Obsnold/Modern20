      "_key": "!actors.items!PCwvRzvMN7eJh3ae.DFe3VUDO6wOo4i5I"
    },
    {
      "_id": "jUw5T37ilXcp4Lej",
      "name": "Chain Reaction",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/magic-swirl.svg",
      "system": {
        "description": "<p>If the nuclear toxyderm is reduced to 0 or fewer hit points, it explodes in a blinding flash of light that deals 400 points of damage to everything (creatures and objects alike) within 400 feet and 100 points of damage to everything within a mile; a successful @Check[save:ref]{Reflex save} halves the damage (DC 10 + 1/2 toxyderm’s Hit Dice + toxyderm’s Dexterity modifier). This explosion generally results in a milehigh mushroom cloud and a highly radioactive crater a quarter-mile across.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
        "abilityType": "supernatural",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!PCwvRzvMN7eJh3ae.jUw5T37ilXcp4Lej"
    },
