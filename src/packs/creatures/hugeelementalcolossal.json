      "img": "systems/modern20/assets/icons/lorc/dragon-breath.svg",
      "system": {
        "description": "<p>The nuclear toxyderm’s breath weapon is a 100-foot cone of white-hot nuclear slag and fullspectrum radiation. It deals 20d6 points of damage to all in its path, or half damage if a @Check[save:ref]{Reflex save} succeeds (DC 10 + 1/2 toxyderm’s Hit Dice + toxyderm’s Constitution modifier). Any creature that takes damage from the cone also suffers a high exposure to radiation (see the Radiation Sickness).</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
