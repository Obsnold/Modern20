    {
      "_id": "pGXoRuKBzWY41IWc",
      "name": "Heat (DC 15)",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/magic-swirl.svg",
      "system": {
        "description": "<p>The intense heat generated by a charred one’s body deals 2d10 points of fire damage to anything it touches. This heat is usually enough to melt nonmagical weapons, but a magic weapon subjected to this effect receives a @Check[save:fort]{Fortitude save} (DC 10 + 1/2 the charred one’s Hit Dice + its Charisma modifier). Flammable items, such as clothing, wood, or paper, are automatically ignited by the touch of a charred one.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat1.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
        "abilityType": "supernatural",
        "sense": false,
        "activities": {
          "save": {
            "type": "save",
            "name": "Heat",
            "actionType": "varies",
            "save": {
              "ability": "fort",
              "calculation": "flat",
              "dc": 15,
              "onSuccess": "negate"
            }
          }
        }
      },
      "_key": "!actors.items!twN7XXjbljN59OuY.pGXoRuKBzWY41IWc"
    },
    {
      "_id": "g03zuqyWJNxmAds9",
      "name": "Incorporeal Subtype",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>A charred one has no physical form and can be harmed only by other incorporeal creatures, +1 or better magic weapons, or magic, though it has a 50% chance to ignore any damage from a corporeal source. The charred one can pass through solid objects at will, and its own attacks pass through armor. The charred one moves in complete silence and cannot be heard at all.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat1.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
        "abilityType": "",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!twN7XXjbljN59OuY.g03zuqyWJNxmAds9"
    },
    {
      "_id": "ycvEI15nKfUkh4cT",
      "name": "Locate Killer",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/magic-swirl.svg",
      "system": {
        "description": "<p>If the charred one was created as the result of arson or careless use of fire, it gains the ability to hunt down the perpetrator. This ability is similar to the effect of a locate object spell (as if cast by a 5th-level Acolyte), but the creature can locate only the creature responsible for its death. A charred one can use this ability once per day.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat1.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
        "abilityType": "supernatural",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!twN7XXjbljN59OuY.ycvEI15nKfUkh4cT"
    },
