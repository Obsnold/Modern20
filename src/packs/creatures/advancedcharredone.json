      "name": "Fire Subtype",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/carl-olsen/flame.svg",
      "system": {
        "description": "<p>A charred one is immune to fire damage. It takes 50% more damage from cold.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat1.html",
