      "_id": "HKZph2vffPozbHZg",
      "name": "Poison Spray (DC 11; spitting cobra only)",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/poison-bottle.svg",
      "system": {
        "description": "<p>At will as a ranged touch attack, a spitting cobra can spray its venom at a target up to 10 feet away. When used in this manner, the spitting cobra\u2019s venom acts as a contact poison. The target must succeed on a @Check[save:fort]{Fortitude save} (DC 10 + 1/2 the cobra\u2019s Hit Dice + its Constitution modifier) or be blinded and nauseated for 1 minute. A second @Check[save:fort]{Fortitude save} must be made 1 minute later to negate the venom\u2019s secondary damage (same as the initial damage). Eye protection, such as goggles or a full-face visor, negates the blindness effect.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
