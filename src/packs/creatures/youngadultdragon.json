    {
      "_id": "LiKdftVNXzftvIch",
      "name": "Fear Aura 150 ft.",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/terror.svg",
      "system": {
        "description": "<p>A fear aura either operates continuously or can be used at will. In either case, it\u2019s a free action. This ability can freeze an opponent or cause opponents to become panicked. Other effects are possible. Negating the fear effect requires a successful @Check[save:will]{Will save} with a DC equal to 10 + 1/2 fearsome creature\u2019s HD + fearsome creature\u2019s Charisma modifier (the exact DC is given in the creature\u2019s descriptive text).</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/specialabilities.html",
        "source": "d20 Modern SRD",
        "abilityType": "supernatural",
        "sense": false,
        "activities": {},
        "rulesPage": "Compendium.modern20.rules.JournalEntry.y98NYAYGT9GM5Mox.JournalEntryPage.vhTyLUgTw1jBipWT"
      },
