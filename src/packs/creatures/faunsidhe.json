    {
      "_id": "aLNguYJFMAvhCIE8",
      "name": "Enchanting Music",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Music is magical to fauns, and they can create a variety of enchanting effects on listeners with a carefully crafted song. When a faun infuses its song with its fey power, all creatures within a 60-foot spread of the satyr (except other sidhe) must succeed at a @Check[save:will|dc:13]{Will save (DC 13)} or be affected by attraction, as the power manifest by a 10thlevel Telepath. Once per day, the faun can use his music to instead create a lesser domination effect (@Check[save:will]{Will save}, DC 15, negates) or mental blast effect (@Check[save:will]{Will save}, DC 15, negates) targeted at one specific listener.</p><p>It takes the faun a full-round action to use enchanting music. Anyone who successfully saves against the faun’s enchanting music cannot be affected by music from that faun for one day.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst3.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
        "abilityType": "supernatural",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!tTgeHLCZUaPIrRSn.aLNguYJFMAvhCIE8"
    },
