    },
    {
      "_id": "8ztHKi8AfqsXbZy9",
      "name": "Gear Grind",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>the gear golem successfully grapples a creature smaller than itself, it grinds the creature with its spinning gears for 4d8 points of slashing damage each round the grapple is maintained (including the round in which the grapple is first achieved).</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst2.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
