    },
    {
      "_id": "XiUc2J8nQtXKd2ov",
      "name": "Improved Grab",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>To use this ability, the gear golem must hit an opponent smaller than itself with its slam attack. If it gets a hold, it attempts to grind its foe against its spinning gears as a free action (see below).</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst2.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
