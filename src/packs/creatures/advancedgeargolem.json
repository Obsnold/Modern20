    },
    {
      "_id": "rzqc00wn24OfkNpo",
      "name": "Detonate (30- foot-radius burst; DC 22)",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>When a gear golem is reduced to 0 or fewer hit points, it explodes in a 20-foot-radius burst of serrated gears and shrapnel. The explosion deals 12d8 points of slashing damage to creatures caught in the radius; a successful Reflex save (DC 19) halves the damage.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst2.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
