    {
      "_id": "BNa62YoExUg7yKis",
      "name": "Improved Grab",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>To use this ability, the giant anaconda must hit an opponent at least one size category smaller than itself with either a bite or a tail slap attack. If it gets a hold, it automatically deals bite or tail slap damage each round that the hold is maintained, and it can constrict in the same round and attempt to swallow in the next round. If the giant anaconda wishes, it can continue to attack with its tail or its bite (not both) while it grapples with its body, but it takes a –20 penalty on all grapple checks if it does so.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat1.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
        "abilityType": "extraordinary",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!B5jQRoinlAKDYA0m.BNa62YoExUg7yKis"
    },
    {
      "_id": "4BBUKfGhn0n6TpVl",
      "name": "Low-Light Vision",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A creature with low-light vision can see twice as far as normal in poor lightning conditions. The creature can still distinguish colors, even in dim lighting.</p>",
