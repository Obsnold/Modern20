    {
      "_id": "HGXqTg51UGntc6bq",
      "name": "Breath Weapon",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A wyrm can breathe a 60-foot-long, 5-foot-wide line of fire every 1d4 rounds as an attack action. Any creature in the line of fire takes 10d10 points of damage, or half damage if a @Check[save:ref|dc:25]{Reflex save (DC 25)} succeeds.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/creatures4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.y98NYAYGT9GM5Mox.JournalEntryPage.Gz87IPdigtsYQV9G",
        "abilityType": "supernatural",
        "sense": false,
        "activities": {}
      },
