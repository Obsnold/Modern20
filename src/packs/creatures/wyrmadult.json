    },
    {
      "_id": "x5bi1isosEUA5H1O",
      "name": "Improved Grab",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>To use this ability, a wyrm must hit with both claw attacks. If it gets a hold, it hangs on and stings. If a wyrm grabs a creature two or more size categories smaller, it automatically deals damage with both claws and its sting each round the hold is maintained. See Improved Grab.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/creatures4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.y98NYAYGT9GM5Mox.JournalEntryPage.Gz87IPdigtsYQV9G",
        "abilityType": "extraordinary",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!OJOC5b8vtyD7iAv3.x5bi1isosEUA5H1O"
    },
    {
      "_id": "Eij4CoyaoyOPt3op",
      "name": "Fling",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A wyrm can drop a creature it has grabbed or use an attack action to fling it aside. A flung creature travels 30 feet and takes 3d6 points of damage. If the wyrm flings it while flying, the creature takes this amount or falling damage, whichever is greater.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/creatures4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.y98NYAYGT9GM5Mox.JournalEntryPage.Gz87IPdigtsYQV9G",
        "abilityType": "extraordinary",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!OJOC5b8vtyD7iAv3.Eij4CoyaoyOPt3op"
    },
    {
      "_id": "x9Ww4Ccexf8GgSbZ",
      "name": "Poison",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A creature stung by a wyrm must succeed on a @Check[save:fort|dc:25]{Fortitude save (DC 25)} or take 2d6 points of temporary Constitution damage. After 1 minute has elapsed, the creature must succeed on a second save (DC 25) or take another 2d6 points of temporary Constitution damage.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/creatures4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.y98NYAYGT9GM5Mox.JournalEntryPage.Gz87IPdigtsYQV9G",
        "abilityType": "extraordinary",
        "sense": false,
