      "_key": "!actors.items!4YUPTPVHYoDOrI3v.HFr3lQkHr37CWoqg"
    },
    {
      "_id": "g56AAKWPzzw85jzw",
      "name": "Wheels",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>Because the living dumpster relies on small caster wheels for locomotion, its speed is reduced by half on very soft or soft surfaces such as mud or thick lawns. It can’t negotiate stairs, although it can hop up or down a curb without difficulty.</p>",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/urbanmonst2.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.F9sDg5FHLKUqVnLh.JournalEntryPage.M5YY3kCExBHCkFHu",
        "source": "Urban Arcana",
