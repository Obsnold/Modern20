      }
    },
    {
      "_id": "5qKiwA5dhuhLQjKJ",
      "name": "Low-Light Vision",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>A creature with low-light vision can see twice as far as normal in poor lightning conditions. The creature can still distinguish colors, even in dim lighting.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/specialabilities.html",
        "abilityType": "extraordinary",
        "sense": true,
        "activities": {}
      }
    },
    {
      "_id": "CSbJ5xxaxoMlXXFe",
      "name": "Selective Invisibility",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Once the night terror has chosen its victim, only that individual can see it. To everyone else, the creature is invisible, as the invisibility spell (caster level 10th). If the night terror attacks anyone, it becomes visible to all viewers until the next sunrise.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat3.html",
        "abilityType": "supernatural",
        "sense": false,
        "activities": {}
      }
    },
    {
      "_id": "i22nedFO6jqv6SxL",
      "name": "Terrify (DC 14)",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Once per night as a full-round action, the night terror can try to feed upon the fear of its chosen victim. The victim must make a successful Will save (DC 10 + 1/2 the night terror’s Hit Dice + its Charisma modifier) or take 1d4 points of Wisdom damage. The night terror can attempt to use this ability only if it has already successfully used its fear aura against the target. If this Wisdom damage would cause the chosen victim’s Wisdom score to fall below 0, the victim must make another Will save. Success leaves the victim’s Wisdom score at 0; failure means the victim dies on the spot.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat3.html",
        "abilityType": "supernatural",
        "sense": false,
        "activities": {
          "save": {
            "type": "save",
            "name": "Terrify",
            "actionType": "fullRound",
            "save": {
              "ability": "will",
              "calculation": "flat",
              "dc": 14,
              "onSuccess": "negate"
            },
            "damage": {
              "formula": "1d4",
              "type": "wisdom",
              "addAbility": false
            }
          }
        }
      }
    },
    {
      "_id": "c5aiARiKeTDCWkt9",
      "name": "Vulnerability (any one)",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Each night terror has a specific irrational weakness that varies with the individual. For each night terror, roll on Table: Sources of Weakness on. Regardless of its nature, the weakness has overpowering strength (Will save DC 20) and causes the aversion effect.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat3.html",
        "abilityType": "extraordinary",
        "sense": false,
        "activities": {}
      }
    },
