      "name": "Skill Bonuses",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>A night terror gains a +4 species bonus on Intimidate and @Check[skill:senseMotive]{Sense Motive check}s during the night. It loses these bonuses during daylight hours.</p>",
