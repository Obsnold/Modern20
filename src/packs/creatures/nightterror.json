    {
      "_id": "TjVPGfRal7R7mK9w",
      "name": "Chosen Victim",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>A night terror can feed on the terror of only one individual at a time. Once it chooses its victim, it can choose another only upon the death of the previous victim or by making a successful @Check[save:will|dc:25]{Will save (DC 25)}.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat3.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
        "abilityType": "extraordinary",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!lCBp0bNJxFVXXcXm.TjVPGfRal7R7mK9w"
    },
    {
      "_id": "evpVsHZccmjRAHmD",
      "name": "Fear Aura (DC 14)",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/terror.svg",
      "system": {
        "description": "<p>A night terror projects a frightful aura that affects all creatures within 30 feet. Creatures in the area that can see the night terror must make a @Check[save:will]{Will save} (DC 10 + 1/2 the night terror’s Hit Dice + its Charisma modifier). Those that fail the save are shaken. The night terror’s chosen victim is left cowering instead of shaken. Creatures that successfully save against a night terror’s fear aura cannot be affected by that particular night terror’s fear aura for 24 hours.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat3.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
        "abilityType": "supernatural",
        "sense": false,
        "activities": {
          "save": {
            "type": "save",
            "name": "Fear Aura",
            "actionType": "varies",
            "save": {
              "ability": "will",
              "calculation": "flat",
              "dc": 14,
              "onSuccess": "negate"
            }
          }
        }
      },
      "_key": "!actors.items!lCBp0bNJxFVXXcXm.evpVsHZccmjRAHmD"
    },
    {
      "_id": "BNDgkOcuusO0tBid",
      "name": "Immune to Fear",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/terror.svg",
      "system": {
        "description": "<p>Night terrors are immune to fear effects.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat3.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
