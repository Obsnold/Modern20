    {
      "_id": "4rqaiFziDyBTZan7",
      "name": "Alternate Form",
      "type": "specialAbility",
      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>As an attack or move action, a cat folk can assume the form of a normal-sized cat or revert to its natural form. In cat form, the creature has the same physical statistics and attributes as a normal cat but retains its normal Intelligence, Wisdom, and Charisma scores, as well as its normal hit points. A cat folk can remain in either form indefinitely.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat1.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
        "abilityType": "supernatural",
        "sense": false,
        "activities": {}
      },
      "_key": "!actors.items!qz1mpHIP8PdruIaz.4rqaiFziDyBTZan7"
    },
