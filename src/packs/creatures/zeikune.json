    {
      "_id": "Fn07tg6k4UQF4Tlt",
      "name": "Darkvision 60 ft.",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/third-eye.svg",
      "system": {
        "description": "<p>The creature can see in total darkness, out to the specified range (usually 60 feet). Darkvision is black-and-white only, but is otherwise like normal light.</p>",
        "source": "d20 Modern SRD",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/specialabilities.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.y98NYAYGT9GM5Mox.JournalEntryPage.vhTyLUgTw1jBipWT",
        "abilityType": "extraordinary",
        "sense": true,
        "activities": {}
      },
