      "img": "icons/svg/aura.svg",
      "system": {
        "description": "<p>Any humanoid bitten by a wererat’s bite attack (in rat or hybrid form) must succeed at a @Check[save:fort|dc:15]{Fortitude save (DC 15)} or contract lycanthropy.</p>",
