    {
      "_id": "bkOxxt9eBmoiUxdp",
      "name": "Hot Running",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>Once per day as a free action, a sand slave can make a @Check[ability:con|dc:15]{Constitution check (DC 15)} to reverse the effects of fatigue and nonlethal damage. A successful check negates all nonlethal damage the sand slave has sustained and reduces fatigue or exhaustion as if the sand slave had rested for a full day.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
        "abilityType": "extraordinary",
        "sense": false,
