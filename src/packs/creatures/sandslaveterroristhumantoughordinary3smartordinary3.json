    {
      "_id": "RoaSC7sUC1l1e9XJ",
      "name": "Network Mind",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/telepathy.svg",
      "system": {
        "description": "<p>A sand slave is automatically aware of the position and general emotional status of any other sand slaves within 200 feet. All sand slaves within that range that can see one another are in constant telepathic communication. If one is aware of a particular threat, they all are. If one sand slave in a particular group is not flatfooted, none of them are. No sand slave in such a group is considered flanked unless they all are.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat4.html",
        "rulesPage": "Compendium.modern20.rules.JournalEntry.gkO7BHtoB7PZOT9Q.JournalEntryPage.QvZNL5dJUs6a3FCL",
