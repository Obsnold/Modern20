    {
      "_id": "hiVheHV909u2KCAd",
      "name": "Immunities",
      "type": "specialAbility",
      "img": "systems/modern20/assets/icons/lorc/aura.svg",
      "system": {
        "description": "<p>The sand slave is immune to disease and poison. The nannites in its body fight off all diseases, including other nannite infections, and break down all poisons before they can take effect.</p>",
        "source": "Menace Manual",
        "srdUrl": "https://spellbooksoftware.com/d20mrsd/menacecreat4.html",
